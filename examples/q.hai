-- Robinson arithmetic Q, relationally: zero and successor are predicates, plus and times are
-- relations, and equality is a predicate with its own axioms.

predicate Zero x
predicate Succ x y
predicate Plus x y z
predicate Times x y z
predicate Eq x y

-- Robinson's seven
define Sz   = forall x y. Succ x y -> not (Zero y)
define Si   = forall x y a b. Succ x a -> Succ y b -> Eq a b -> Eq x y
define Pred = forall x. not (Zero x) -> exists y. Succ y x
define Pz   = forall x z. Zero z -> Plus x z x
define Ps   = forall x y s p q. Succ y s -> Plus x y p -> Succ p q -> Plus x s q
define Tz   = forall x z. Zero z -> Times x z z
define Ts   = forall x y s p q. Succ y s -> Times x y p -> Plus p x q -> Times x s q
-- values exist and are unique
define Ze   = exists z. Zero z
define Zu   = forall a b. Zero a -> Zero b -> Eq a b
define Se   = forall x. exists y. Succ x y
define Su   = forall x a b. Succ x a -> Succ x b -> Eq a b
define Pe   = forall x y. exists z. Plus x y z
define Pu   = forall x y a b. Plus x y a -> Plus x y b -> Eq a b
define Te   = forall x y. exists z. Times x y z
define Tu   = forall x y a b. Times x y a -> Times x y b -> Eq a b
-- equality
define Refl = forall x. Eq x x
define Ee   = forall x y x1 y1. Eq x x1 -> Eq y y1 -> Eq x y -> Eq x1 y1
define Ez   = forall x x1. Eq x x1 -> Zero x -> Zero x1
define Es   = forall x y x1 y1. Eq x x1 -> Eq y y1 -> Succ x y -> Succ x1 y1
define Ep   = forall x y z x1 y1 z1. Eq x x1 -> Eq y y1 -> Eq z z1 -> Plus x y z -> Plus x1 y1 z1
define Et   = forall x y z x1 y1 z1. Eq x x1 -> Eq y y1 -> Eq z z1 -> Times x y z -> Times x1 y1 z1

-- Q is their conjunction: one formula, assumed by a theorem like any other.
define Q = Sz and Si and Pred and Pz and Ps and Tz and Ts and Ze and Zu and Se and Su and Pe and Pu and Te and Tu and Refl and Ee and Ez and Es and Ep and Et

-- Whatever is zero, added to itself, gives itself.
theorem zero_plus_zero:
  assume ax: Q
  pz: Pz                                  by and_e ax
  lemma all:
    variable w
    assume zw: Zero w
    p: Plus w w w                         by imp_e pz zw
    therefore forall w. Zero w -> Plus w w w
  therefore Q -> forall w. Zero w -> Plus w w w
