{- Robinson arithmetic Q, relationally: zero and successor are predicates, plus and times are
   relations, and equality is a predicate with its own axioms. -}

theory Q
  {- Robinson's seven -}
  sz:   forall x y. Succ x y -> not (Zero y)
  si:   forall x y a b. Succ x a -> Succ y b -> Eq a b -> Eq x y
  pred: forall x. not (Zero x) -> exists y. Succ y x
  pz:   forall x z. Zero z -> Plus x z x
  ps:   forall x y s p q. Succ y s -> Plus x y p -> Succ p q -> Plus x s q
  tz:   forall x z. Zero z -> Times x z z
  ts:   forall x y s p q. Succ y s -> Times x y p -> Plus p x q -> Times x s q
  {- values exist and are unique -}
  ze:   exists z. Zero z
  zu:   forall a b. Zero a -> Zero b -> Eq a b
  se:   forall x. exists y. Succ x y
  su:   forall x a b. Succ x a -> Succ x b -> Eq a b
  pe:   forall x y. exists z. Plus x y z
  pu:   forall x y a b. Plus x y a -> Plus x y b -> Eq a b
  te:   forall x y. exists z. Times x y z
  tu:   forall x y a b. Times x y a -> Times x y b -> Eq a b
  {- equality -}
  refl: forall x. Eq x x
  ee:   forall x y x1 y1. Eq x x1 -> Eq y y1 -> Eq x y -> Eq x1 y1
  ez:   forall x x1. Eq x x1 -> Zero x -> Zero x1
  es:   forall x y x1 y1. Eq x x1 -> Eq y y1 -> Succ x y -> Succ x1 y1
  ep:   forall x y z x1 y1 z1. Eq x x1 -> Eq y y1 -> Eq z z1 -> Plus x y z -> Plus x1 y1 z1
  et:   forall x y z x1 y1 z1. Eq x x1 -> Eq y y1 -> Eq z z1 -> Times x y z -> Times x1 y1 z1

{- Whatever is zero, added to itself, gives itself. -}
theorem zero_plus_zero in Q
  assume zw: Zero w
  p: Plus w w w                           by Q.pz zw
  z: Zero w -> Plus w w w                 by imp_i zw p
  zero_plus_zero: forall w. Zero w -> Plus w w w
                                          by forall_i w z
