-- Addition on unary numerals, as an inductive relation. The first computation over FS0.

import syntax

predicate Add x y z

define Ab = forall x z. Nat x -> Nil z -> Add x z x
define As = forall x y z y1 z1. Add x y z -> Suc y y1 -> Suc z z1 -> Add x y1 z1
define Qa = forall x y z x1 y1 z1. Eq x x1 -> Eq y y1 -> Eq z z1 -> Add x y z -> Add x1 y1 z1

define PLUS = NAT and Ab and As and Qa

define AddLeast (P x y z) = (forall x z. Nat x -> Nil z -> P x z x)
    -> (forall x y z y1 z1. Add x y z -> P x y z -> Suc y y1 -> Suc z z1 -> P x y1 z1)
    -> forall x y z. Add x y z -> P x y z

define AddEx x y = exists z. Add x y z

-- Addition is total on numerals.
theorem add_total:
  assume plus: PLUS
  assume least: forall x. NatLeast (AddEx x)
  fs0: FS0                          by and_e plus
  ab: Ab                            by and_e plus
  as: As                            by and_e plus
  sucs: forall s. exists t. Suc s t by imp_e suc_exists fs0
  lemma all:
    variable x y
    assume hx: Nat x
    assume hy: Nat y
    lemma base:
      variable n
      assume nn: Nil n
      a: Add x n x by imp_e ab hx nn
      e: AddEx x n by exists_i a
      therefore forall n. Nil n -> AddEx x n
    lemma step:
      variable z n s
      assume nz: Nil z
      assume ih: AddEx x n
      assume pz: Pair z n s
      lemma w1:
        variable w
        assume aw: Add x n w
        su: exists t. Suc w t by forall_e sucs w
        lemma w2:
          variable t
          assume st: Suc w t
          c: Nil z and Pair z n s by and_i nz pz
          sn: Suc n s             by exists_i c
          a: Add x s t            by imp_e as aw sn st
          e: AddEx x s            by exists_i a
          therefore forall t. Suc w t -> AddEx x s
        f1: AddEx x s by exists_e su w2
        therefore forall w. Add x n w -> AddEx x s
      f2: AddEx x s by exists_e ih w1
      therefore forall z n s. Nil z -> AddEx x n -> Pair z n s -> AddEx x s
    lx: NatLeast (AddEx x)             by forall_e least x
    r: forall y1. Nat y1 -> AddEx x y1 by imp_e lx base step
    k: AddEx x y                       by imp_e r hy
    therefore forall x y. Nat x -> Nat y -> AddEx x y
  therefore PLUS -> (forall x. NatLeast (AddEx x)) -> forall x y. Nat x -> Nat y -> AddEx x y

-- Sums of numerals are numerals.
define AddNat x y z = Nat x -> Nat z

theorem add_nat:
  assume plus: PLUS
  assume least: AddLeast AddNat
  sn: Sn by and_e plus
  lemma c0:
    variable x z
    assume nx: Nat x
    assume nz: Nil z
    lemma k:
      assume n: Nat x
      r: Nat x by reit n
      therefore Nat x -> Nat x
    therefore forall x z. Nat x -> Nil z -> AddNat x z x
  lemma c1:
    variable x y z y1 z1
    assume a: Add x y z
    assume ih: AddNat x y z
    assume sy: Suc y y1
    assume sz: Suc z z1
    lemma k:
      assume nx: Nat x
      nz: Nat z by imp_e ih nx
      lemma w:
        variable o
        assume h: Nil o and Pair o z z1
        no: Nil o       by and_e h
        po: Pair o z z1 by and_e h
        n1: Nat z1      by imp_e sn no nz po
        therefore forall o. (Nil o and Pair o z z1) -> Nat z1
      r: Nat z1 by exists_e sz w
      therefore Nat x -> Nat z1
    therefore forall x y z y1 z1. Add x y z -> AddNat x y z -> Suc y y1 -> Suc z z1 -> AddNat x y1 z1
  r: forall x y z. Add x y z -> AddNat x y z
      by imp_e least c0 c1
  therefore PLUS -> AddLeast AddNat -> forall x y z. Add x y z -> AddNat x y z

-- An addition is the base case or a step.
define AddShape x y z = (Nil y and Eq z x) or (exists y0 z0. Add x y0 z0 and Suc y0 y and Suc z0 z)

theorem add_inv:
  assume fs0: FS0
  assume least: AddLeast AddShape
  refl: Refl by and_e fs0
  lemma c0:
    variable x z
    assume nx: Nat x
    assume nz: Nil z
    rx: Eq x x          by forall_e refl x
    b: Nil z and Eq x x by and_i nz rx
    r: AddShape x z x   by or_i b
    therefore forall x z. Nat x -> Nil z -> AddShape x z x
  lemma c1:
    variable x y z y1 z1
    assume ad: Add x y z
    assume ih: AddShape x y z
    assume sy: Suc y y1
    assume sz: Suc z z1
    c: Add x y z and Suc y y1 and Suc z z1
                        by and_i ad sy sz
    e: exists y0 z0. Add x y0 z0 and Suc y0 y1 and Suc z0 z1
                        by exists_i c
    r: AddShape x y1 z1 by or_i e
    therefore forall x y z y1 z1. Add x y z -> AddShape x y z -> Suc y y1 -> Suc z z1 -> AddShape x y1 z1
  r: forall x y z. Add x y z -> AddShape x y z
      by imp_e least c0 c1
  therefore FS0 -> AddLeast AddShape -> forall x y z. Add x y z -> AddShape x y z

-- Multiplication, the same way: x times 0 is 0, and x times y + 1 is x times y, plus x.
predicate Mul x y z

define Mb = forall x z. Nat x -> Nil z -> Mul x z z
define Ms = forall x y z y1 z1. Mul x y z -> Suc y y1 -> Add z x z1 -> Mul x y1 z1
define Qm = forall x y z x1 y1 z1. Eq x x1 -> Eq y y1 -> Eq z z1 -> Mul x y z -> Mul x1 y1 z1

define TIMES = PLUS and Mb and Ms and Qm

define MulLeast (P x y z) = (forall x z. Nat x -> Nil z -> P x z z)
    -> (forall x y z y1 z1. Mul x y z -> P x y z -> Suc y y1 -> Add z x z1 -> P x y1 z1)
    -> forall x y z. Mul x y z -> P x y z

-- Multiplication is total on numerals, with numerals for values.
define MulEx x y = exists z. Mul x y z and Nat z

theorem mul_total:
  assume times: TIMES
  assume addl: forall x. NatLeast (AddEx x)
  assume natl: AddLeast AddNat
  assume least: forall x. NatLeast (MulEx x)
  plus: PLUS by and_e times
  zn: Zn     by and_e times
  mb: Mb     by and_e times
  ms: Ms     by and_e times
  lemma all:
    variable x
    assume nx: Nat x
    lx: NatLeast (MulEx x) by forall_e least x
    lemma c0:
      variable n
      assume nn: Nil n
      m: Mul x n n           by imp_e mb nx nn
      nm: Nat n              by imp_e zn nn
      c: Mul x n n and Nat n by and_i m nm
      e: MulEx x n           by exists_i c
      therefore forall n. Nil n -> MulEx x n
    lemma c1:
      variable o n s
      assume no: Nil o
      assume ih: MulEx x n
      assume po: Pair o n s
      op: Nil o and Pair o n s by and_i no po
      sn: Suc n s              by exists_i op
      lemma w1:
        variable z
        assume h: Mul x n z and Nat z
        mz: Mul x n z by and_e h
        nz: Nat z     by and_e h
        ea: AddEx z x by imp_e add_total plus addl nz nx
        lemma w2:
          variable z1
          assume az: Add z x z1
          m1: Mul x s z1           by imp_e ms mz sn az
          an: AddNat z x z1        by imp_e add_nat plus natl az
          n1: Nat z1               by imp_e an nz
          c: Mul x s z1 and Nat z1 by and_i m1 n1
          e: MulEx x s             by exists_i c
          therefore forall z1. Add z x z1 -> MulEx x s
        r: MulEx x s by exists_e ea w2
        therefore forall z. (Mul x n z and Nat z) -> MulEx x s
      r: MulEx x s by exists_e ih w1
      therefore forall o n s. Nil o -> MulEx x n -> Pair o n s -> MulEx x s
    r: forall y. Nat y -> MulEx x y by imp_e lx c0 c1
    therefore forall x. Nat x -> forall y. Nat y -> MulEx x y
  therefore TIMES -> (forall x. NatLeast (AddEx x)) -> AddLeast AddNat -> (forall x. NatLeast (MulEx x))
      -> forall x. Nat x -> forall y. Nat y -> MulEx x y

-- A multiplication is the base case or a step.
define MulShape x y z = (Nil y and Nil z) or (exists y0 z0. Mul x y0 z0 and Suc y0 y and Add z0 x z)

theorem mul_inv:
  assume least: MulLeast MulShape
  lemma c0:
    variable x z
    assume nx: Nat x
    assume nz: Nil z
    b: Nil z and Nil z by and_i nz nz
    r: MulShape x z z  by or_i b
    therefore forall x z. Nat x -> Nil z -> MulShape x z z
  lemma c1:
    variable x y z y1 z1
    assume mu: Mul x y z
    assume ih: MulShape x y z
    assume sy: Suc y y1
    assume ad: Add z x z1
    c: Mul x y z and Suc y y1 and Add z x z1
                        by and_i mu sy ad
    e: exists y0 z0. Mul x y0 z0 and Suc y0 y1 and Add z0 x z1
                        by exists_i c
    r: MulShape x y1 z1 by or_i e
    therefore forall x y z y1 z1. Mul x y z -> MulShape x y z -> Suc y y1 -> Add z x z1 -> MulShape x y1 z1
  r: forall x y z. Mul x y z -> MulShape x y z
      by imp_e least c0 c1
  therefore MulLeast MulShape -> forall x y z. Mul x y z -> MulShape x y z

-- Pairing on numbers: z is (x + y) times (x + y), plus x. Injective, since for s = x + y the
-- values sit between s times s and (s + 1) times (s + 1), and that is all a coding needs.
define PairN x y z = exists s q. Add x y s and Mul s s q and Add q x z

theorem pairn_exists:
  variable x y
  assume times: TIMES
  assume addl: forall x1. NatLeast (AddEx x1)
  assume natl: AddLeast AddNat
  assume mull: forall x1. NatLeast (MulEx x1)
  assume nx: Nat x
  assume ny: Nat y
  plus: PLUS    by and_e times
  es: AddEx x y by imp_e add_total plus addl nx ny
  lemma w1:
    variable s
    assume a1: Add x y s
    ns: Nat s     by imp_e add_nat plus natl a1 nx
    eq: MulEx s s by imp_e mul_total times addl natl mull ns ns
    lemma w2:
      variable q
      assume h: Mul s s q and Nat q
      m: Mul s s q  by and_e h
      nq: Nat q     by and_e h
      ez: AddEx q x by imp_e add_total plus addl nq nx
      lemma w3:
        variable z
        assume a2: Add q x z
        c: Add x y s and Mul s s q and Add q x z
                                 by and_i a1 m a2
        pz: PairN x y z          by exists_i c
        nz: Nat z                by imp_e add_nat plus natl a2 nq
        k: PairN x y z and Nat z by and_i pz nz
        e: exists z1. PairN x y z1 and Nat z1
                                 by exists_i k
        therefore forall z. Add q x z -> exists z1. PairN x y z1 and Nat z1
      r: exists z. PairN x y z and Nat z by exists_e ez w3
      therefore forall q. (Mul s s q and Nat q) -> exists z. PairN x y z and Nat z
    r: exists z. PairN x y z and Nat z by exists_e eq w2
    therefore forall s. Add x y s -> exists z. PairN x y z and Nat z
  r: exists z. PairN x y z and Nat z by exists_e es w1
  therefore forall x y. TIMES -> (forall x1. NatLeast (AddEx x1)) -> AddLeast AddNat -> (forall x2. NatLeast (MulEx x2))
      -> Nat x -> Nat y -> exists z. PairN x y z and Nat z
