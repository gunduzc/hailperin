-- Negations inside Q. A negation is an implication to absurd, and is reached by combinators,
-- not by the deduction theorem: the facts about names are about h, and a proof from more
-- hypotheses than h is not one from h. QI h a b says h proves a -> b, QI2 h a b c says it
-- proves a -> (b -> c), and QNot h a says it proves a -> absurd.

import times

define QI h a b     = exists c. ImpCode a b c and PrH h c
define QI2 h a b c  = exists bc. ImpCode b c bc and QI h a bc
define QNot h a     = exists z. BotCode z and QI h a z

-- The code of absurd exists, and is a formula.
theorem bot_exists:
  assume fs0: FS0
  ne: Ne                                  by and_e fs0
  t0: exists t. T0 t                      by reit ne
  lemma wit:
    variable n
    assume nn: Nil n
    ez: exists x. Node1 T0 n x            by imp_e node1_exists T0 fs0 t0
    lemma w2:
      variable z
      assume nd: Node1 T0 n z
      c: Nil n and Node1 T0 n z           by and_i nn nd
      b: BotCode z                        by exists_i c
      r: exists z1. BotCode z1              by exists_i b
      therefore forall z. Node1 T0 n z -> exists z1. BotCode z1
    r: exists z. BotCode z                by exists_e ez w2
    therefore forall n. Nil n -> exists z. BotCode z
  r: exists z. BotCode z                  by exists_e ne wit
  therefore FS0 -> exists z. BotCode z

theorem bot_form:
  variable z
  assume form: FORM
  assume bz:   BotCode z
  fbot: Fbot                              by and_e form
  lemma wit:
    variable n
    assume h: Nil n and Node1 T0 n z
    nn: Nil n                             by and_e h
    nd: Node1 T0 n z                      by and_e h
    r:  Form z                            by imp_e fbot nn nd
    therefore forall n. (Nil n and Node1 T0 n z) -> Form z
  r: Form z                               by exists_e bz wit
  therefore forall z. FORM -> BotCode z -> Form z

-- Hypothetical syllogism: from a -> b and b -> c, a -> c.
theorem qi_hs:
  variable h a b c
  assume fs0:   FS0
  assume form:  FORM
  assume logax: LOGAX
  assume prf:   PRF QAx
  assume fa:    Form a
  assume fb:    Form b
  assume fc:    Form c
  assume qab:   QI h a b
  assume qbc:   QI h b c
  tags: Tags                              by imp_e tag_exists fs0
  t2:   exists t. T2 t                    by and_e tags
  lemma w1:
    variable ab
    assume h1: ImpCode a b ab and PrH h ab
    iab: ImpCode a b ab                   by and_e h1
    pab: PrH h ab                         by and_e h1
    lemma w2:
      variable bc
      assume h2: ImpCode b c bc and PrH h bc
      ibc: ImpCode b c bc                 by and_e h2
      pbc: PrH h bc                       by and_e h2
      ex:  exists x. Node2 T2 a c x       by imp_e node2_exists T2 fs0 t2
      lemma w3:
        variable ac
        assume iac: ImpCode a c ac
        pac: PrH h ac                     by imp_e prh_hs QAx fs0 form logax prf fa fb fc iab ibc iac pab pbc
        k:   ImpCode a c ac and PrH h ac  by and_i iac pac
        r:   QI h a c                     by exists_i k
        therefore forall ac. ImpCode a c ac -> QI h a c
      r: QI h a c                         by exists_e ex w3
      therefore forall bc. (ImpCode b c bc and PrH h bc) -> QI h a c
    r: QI h a c                           by exists_e qbc w2
    therefore forall ab. (ImpCode a b ab and PrH h ab) -> QI h a c
  r: QI h a c                             by exists_e qab w1
  therefore forall h a b c. FS0 -> FORM -> LOGAX -> PRF QAx -> Form a -> Form b -> Form c -> QI h a b -> QI h b c
              -> QI h a c

-- From a -> (b -> c) and b, a -> c: K gives a -> b, then S.
theorem qi_skip:
  variable h a b c
  assume fs0:   FS0
  assume form:  FORM
  assume logax: LOGAX
  assume prf:   PRF QAx
  assume fa:    Form a
  assume fb:    Form b
  assume fc:    Form c
  assume q2:    QI2 h a b c
  assume pb:    PrH h b
  tags: Tags                              by imp_e tag_exists fs0
  t2:   exists t. T2 t                    by and_e tags
  lemma w1:
    variable bc
    assume h1: ImpCode b c bc and QI h a bc
    ibc: ImpCode b c bc                   by and_e h1
    qa:  QI h a bc                        by and_e h1
    lemma w2:
      variable abc
      assume h2: ImpCode a bc abc and PrH h abc
      iabc: ImpCode a bc abc              by and_e h2
      pabc: PrH h abc                     by and_e h2
      eab:  exists x. Node2 T2 a b x      by imp_e node2_exists T2 fs0 t2
      lemma w3:
        variable ab
        assume iab: ImpCode a b ab
        pab: PrH h ab                     by imp_e prh_k QAx fs0 form logax prf pb fa fb iab
        eac: exists x. Node2 T2 a c x     by imp_e node2_exists T2 fs0 t2
        lemma w4:
          variable ac
          assume iac: ImpCode a c ac
          pac: PrH h ac                   by imp_e prh_s QAx fs0 form logax prf fa fb fc ibc iabc iab iac pabc pab
          k:   ImpCode a c ac and PrH h ac
                                          by and_i iac pac
          r: QI h a c                     by exists_i k
          therefore forall ac. ImpCode a c ac -> QI h a c
        r: QI h a c                       by exists_e eac w4
        therefore forall ab. ImpCode a b ab -> QI h a c
      r: QI h a c                         by exists_e eab w3
      therefore forall abc. (ImpCode a bc abc and PrH h abc) -> QI h a c
    r: QI h a c                           by exists_e qa w2
    therefore forall bc. (ImpCode b c bc and QI h a bc) -> QI h a c
  r: QI h a c                             by exists_e q2 w1
  therefore forall h a b c. FS0 -> FORM -> LOGAX -> PRF QAx -> Form a -> Form b -> Form c -> QI2 h a b c -> PrH h b
              -> QI h a c

-- A negation travels back along an implication.
theorem neg_hs:
  variable h a b
  assume fs0:   FS0
  assume form:  FORM
  assume logax: LOGAX
  assume prf:   PRF QAx
  assume fa:    Form a
  assume fb:    Form b
  assume qab:   QI h a b
  assume nb:    QNot h b
  lemma wit:
    variable z
    assume hz: BotCode z and QI h b z
    bz:  BotCode z                        by and_e hz
    qbz: QI h b z                         by and_e hz
    fz:  Form z                           by imp_e bot_form form bz
    qaz: QI h a z                         by imp_e qi_hs fs0 form logax prf fa fb fz qab qbz
    k:   BotCode z and QI h a z           by and_i bz qaz
    r:   QNot h a                         by exists_i k
    therefore forall z. (BotCode z and QI h b z) -> QNot h a
  r: QNot h a                             by exists_e nb wit
  therefore forall h a b. FS0 -> FORM -> LOGAX -> PRF QAx -> Form a -> Form b -> QI h a b -> QNot h b -> QNot h a

-- h proves Eq a c -> Eq c a: Ee, with Refl given twice under the antecedent.
theorem qeq_sym_i:
  variable h a c e1 e2
  assume q:   QCtx
  assume na:  Nat a
  assume nc:  Nat c
  assume x1:  EqAt a c e1
  assume x2:  EqAt c a e2
  fs0:   FS0                              by and_e q
  form:  FORM                             by and_e q
  logax: LOGAX                            by and_e q
  prf:   PRF QAx                          by and_e q
  fim:   Fim                              by and_e form
  tags:  Tags                             by imp_e tag_exists fs0
  t2:    exists t. T2 t                   by and_e tags
  f1:    Form e1                          by imp_e eqat_form form na nc x1
  f2:    Form e2                          by imp_e eqat_form form nc na x2
  ea:    exists x. EqAt a a x             by imp_e eqat_exists fs0
  lemma w1:
    variable aa
    assume xa: EqAt a a aa
    fa: Form aa                           by imp_e eqat_form form na na xa
    pa: PrH h aa                          by imp_e q_refl fs0 prf na xa fa
    e8: exists x. Node2 T2 aa e2 x        by imp_e node2_exists T2 fs0 t2
    lemma w2:
      variable c8
      assume i8: ImpCode aa e2 c8
      f8: Form c8                         by imp_e fim fa f2 i8
      e6: exists x. Node2 T2 aa c8 x      by imp_e node2_exists T2 fs0 t2
      lemma w3:
        variable c6
        assume i6: ImpCode aa c8 c6
        e4: exists x. Node2 T2 e1 c6 x    by imp_e node2_exists T2 fs0 t2
        lemma w4:
          variable c4
          assume i4: ImpCode e1 c6 c4
          p4: PrH h c4                    by imp_e q_ee_pre fs0 form prf na na nc na i4 i6 i8 x2 xa xa x1 f1 fa
                                             fa f2
          k4: ImpCode e1 c6 c4 and PrH h c4
                                          by and_i i4 p4
          q4: QI h e1 c6                  by exists_i k4
          k6: ImpCode aa c8 c6 and QI h e1 c6
                                          by and_i i6 q4
          d6: QI2 h e1 aa c8              by exists_i k6
          q8: QI h e1 c8                  by imp_e qi_skip fs0 form logax prf f1 fa f8 d6 pa
          k8: ImpCode aa e2 c8 and QI h e1 c8
                                          by and_i i8 q8
          d8: QI2 h e1 aa e2              by exists_i k8
          r:  QI h e1 e2                  by imp_e qi_skip fs0 form logax prf f1 fa f2 d8 pa
          therefore forall c4. ImpCode e1 c6 c4 -> QI h e1 e2
        r: QI h e1 e2                     by exists_e e4 w4
        therefore forall c6. ImpCode aa c8 c6 -> QI h e1 e2
      r: QI h e1 e2                       by exists_e e6 w3
      therefore forall c8. ImpCode aa e2 c8 -> QI h e1 e2
    r: QI h e1 e2                         by exists_e e8 w2
    therefore forall aa. EqAt a a aa -> QI h e1 e2
  r: QI h e1 e2                           by exists_e ea w1
  therefore forall h a c e1 e2. QCtx -> Nat a -> Nat c -> EqAt a c e1 -> EqAt c a e2 -> QI h e1 e2

-- Names of different numbers are provably different. QNeq h a c says h proves not (a = c).
define QNeq h a c = exists e. EqAt a c e and QNot h e

-- Zero is no successor: Sz gives not (Zero c), and Ez, with Zero a given, Eq a c -> Zero c.
theorem neq_zero_succ:
  variable h a c0 c
  assume q:   QCtx
  assume na:  Nat a
  assume nc0: Nat c0
  assume nc:  Nat c
  assume qa:  QZero h a
  assume qs:  QSucc h c0 c
  fs0:   FS0                              by and_e q
  form:  FORM                             by and_e q
  logax: LOGAX                            by and_e q
  prf:   PRF QAx                          by and_e q
  pfl:   PrfLeast QAx PFormP              by and_e q
  fim:   Fim                              by and_e form
  tags:  Tags                             by imp_e tag_exists fs0
  t2:    exists t. T2 t                   by and_e tags
  lemma w1:
    variable za
    assume h1: ZeroAt a za and PrH h za
    xza: ZeroAt a za                      by and_e h1
    pza: PrH h za                         by and_e h1
    fza: Form za                          by imp_e zeroat_form form na xza
    lemma w2:
      variable s
      assume h2: SuccAt c0 c s and PrH h s
      xs:  SuccAt c0 c s                  by and_e h2
      ps:  PrH h s                        by and_e h2
      ezc: exists x. ZeroAt c x           by imp_e zeroat_exists fs0
      lemma w3:
        variable zc
        assume xzc: ZeroAt c zc
        fzc: Form zc                      by imp_e zeroat_form form nc xzc
        eb:  exists z. BotCode z          by imp_e bot_exists fs0
        lemma w4:
          variable z
          assume bz: BotCode z
          fz: Form z                      by imp_e bot_form form bz
          en: exists x. Node2 T2 zc z x   by imp_e node2_exists T2 fs0 t2
          lemma w5:
            variable nzc
            assume inz: ImpCode zc z nzc
            cn:  BotCode z and ImpCode zc z nzc
                                          by and_i bz inz
            ncd: NotCode zc nzc           by exists_i cn
            fn:  Form nzc                 by imp_e fim fzc fz inz
            pn:  PrH h nzc                by imp_e q_sz fs0 form prf pfl nc0 nc ncd xzc xs ps fn
            kn:  ImpCode zc z nzc and PrH h nzc
                                          by and_i inz pn
            qn: QI h zc z                 by exists_i kn
            kb: BotCode z and QI h zc z   by and_i bz qn
            nq: QNot h zc                 by exists_i kb
            ee: exists x. EqAt a c x      by imp_e eqat_exists fs0
            lemma w6:
              variable e
              assume xe: EqAt a c e
              fe: Form e                  by imp_e eqat_form form na nc xe
              e4: exists x. Node2 T2 za zc x
                                          by imp_e node2_exists T2 fs0 t2
              lemma w7:
                variable c4
                assume i4: ImpCode za zc c4
                e2: exists x. Node2 T2 e c4 x
                                          by imp_e node2_exists T2 fs0 t2
                lemma w8:
                  variable c2
                  assume i2: ImpCode e c4 c2
                  p2: PrH h c2            by imp_e q_ez_pre fs0 form prf na nc i2 i4 xzc xza xe fe fza fzc
                  k2: ImpCode e c4 c2 and PrH h c2
                                          by and_i i2 p2
                  q2: QI h e c4           by exists_i k2
                  kd: ImpCode za zc c4 and QI h e c4
                                          by and_i i4 q2
                  d2: QI2 h e za zc       by exists_i kd
                  qz: QI h e zc           by imp_e qi_skip fs0 form logax prf fe fza fzc d2 pza
                  ne: QNot h e            by imp_e neg_hs fs0 form logax prf fe fzc qz nq
                  cc: EqAt a c e and QNot h e
                                          by and_i xe ne
                  r: QNeq h a c           by exists_i cc
                  therefore forall c2. ImpCode e c4 c2 -> QNeq h a c
                r: QNeq h a c             by exists_e e2 w8
                therefore forall c4. ImpCode za zc c4 -> QNeq h a c
              r: QNeq h a c               by exists_e e4 w7
              therefore forall e. EqAt a c e -> QNeq h a c
            r: QNeq h a c                 by exists_e ee w6
            therefore forall nzc. ImpCode zc z nzc -> QNeq h a c
          r: QNeq h a c                   by exists_e en w5
          therefore forall z. BotCode z -> QNeq h a c
        r: QNeq h a c                     by exists_e eb w4
        therefore forall zc. ZeroAt c zc -> QNeq h a c
      r: QNeq h a c                       by exists_e ezc w3
      therefore forall s. (SuccAt c0 c s and PrH h s) -> QNeq h a c
    r: QNeq h a c                         by exists_e qs w2
    therefore forall za. (ZeroAt a za and PrH h za) -> QNeq h a c
  r: QNeq h a c                           by exists_e qa w1
  therefore forall h a c0 c. QCtx -> Nat a -> Nat c0 -> Nat c -> QZero h a -> QSucc h c0 c -> QNeq h a c

-- A successor is not zero: the case above, and symmetry.
theorem neq_succ_zero:
  variable h a0 a c
  assume q:   QCtx
  assume na0: Nat a0
  assume na:  Nat a
  assume nc:  Nat c
  assume qs:  QSucc h a0 a
  assume qz:  QZero h c
  fs0:   FS0                              by and_e q
  form:  FORM                             by and_e q
  logax: LOGAX                            by and_e q
  prf:   PRF QAx                          by and_e q
  r1:    QNeq h c a                       by imp_e neq_zero_succ q nc na0 na qz qs
  lemma w1:
    variable e1
    assume h1: EqAt c a e1 and QNot h e1
    x1: EqAt c a e1                       by and_e h1
    n1: QNot h e1                         by and_e h1
    f1: Form e1                           by imp_e eqat_form form nc na x1
    ee: exists x. EqAt a c x              by imp_e eqat_exists fs0
    lemma w2:
      variable e
      assume xe: EqAt a c e
      fe: Form e                          by imp_e eqat_form form na nc xe
      sy: QI h e e1                       by imp_e qeq_sym_i q na nc xe x1
      ne: QNot h e                        by imp_e neg_hs fs0 form logax prf fe f1 sy n1
      cc: EqAt a c e and QNot h e         by and_i xe ne
      r:  QNeq h a c                      by exists_i cc
      therefore forall e. EqAt a c e -> QNeq h a c
    r: QNeq h a c                         by exists_e ee w2
    therefore forall e1. (EqAt c a e1 and QNot h e1) -> QNeq h a c
  r: QNeq h a c                           by exists_e r1 w1
  therefore forall h a0 a c. QCtx -> Nat a0 -> Nat a -> Nat c -> QSucc h a0 a -> QZero h c -> QNeq h a c

-- Successors of different numbers are different: Si.
theorem neq_succ_succ:
  variable h a0 a c0 c
  assume q:   QCtx
  assume na0: Nat a0
  assume na:  Nat a
  assume nc0: Nat c0
  assume nc:  Nat c
  assume sa:  QSucc h a0 a
  assume sc:  QSucc h c0 c
  assume n0:  QNeq h a0 c0
  fs0:   FS0                              by and_e q
  form:  FORM                             by and_e q
  logax: LOGAX                            by and_e q
  prf:   PRF QAx                          by and_e q
  pfl:   PrfLeast QAx PFormP              by and_e q
  tags:  Tags                             by imp_e tag_exists fs0
  t2:    exists t. T2 t                   by and_e tags
  lemma w1:
    variable s1
    assume h1: SuccAt a0 a s1 and PrH h s1
    x1: SuccAt a0 a s1                    by and_e h1
    p1: PrH h s1                          by and_e h1
    lemma w2:
      variable s2
      assume h2: SuccAt c0 c s2 and PrH h s2
      x2: SuccAt c0 c s2                  by and_e h2
      p2: PrH h s2                        by and_e h2
      lemma w3:
        variable e0
        assume h3: EqAt a0 c0 e0 and QNot h e0
        x0: EqAt a0 c0 e0                 by and_e h3
        q0: QNot h e0                     by and_e h3
        f0: Form e0                       by imp_e eqat_form form na0 nc0 x0
        ee: exists x. EqAt a c x          by imp_e eqat_exists fs0
        lemma w4:
          variable e
          assume xe: EqAt a c e
          fe: Form e                      by imp_e eqat_form form na nc xe
          e8: exists x. Node2 T2 e e0 x   by imp_e node2_exists T2 fs0 t2
          lemma w5:
            variable c8
            assume i8: ImpCode e e0 c8
            p8: PrH h c8                  by imp_e q_si_pre fs0 form prf pfl na0 nc0 na nc i8 x0 xe x2 x1 p1 p2
                                             fe f0
            k8: ImpCode e e0 c8 and PrH h c8
                                          by and_i i8 p8
            qi: QI h e e0                 by exists_i k8
            ne: QNot h e                  by imp_e neg_hs fs0 form logax prf fe f0 qi q0
            cc: EqAt a c e and QNot h e   by and_i xe ne
            r:  QNeq h a c                by exists_i cc
            therefore forall c8. ImpCode e e0 c8 -> QNeq h a c
          r: QNeq h a c                   by exists_e e8 w5
          therefore forall e. EqAt a c e -> QNeq h a c
        r: QNeq h a c                     by exists_e ee w4
        therefore forall e0. (EqAt a0 c0 e0 and QNot h e0) -> QNeq h a c
      r: QNeq h a c                       by exists_e n0 w3
      therefore forall s2. (SuccAt c0 c s2 and PrH h s2) -> QNeq h a c
    r: QNeq h a c                         by exists_e sc w2
    therefore forall s1. (SuccAt a0 a s1 and PrH h s1) -> QNeq h a c
  r: QNeq h a c                           by exists_e sa w1
  therefore forall h a0 a c0 c. QCtx -> Nat a0 -> Nat a -> Nat c0 -> Nat c -> QSucc h a0 a -> QSucc h c0 c
              -> QNeq h a0 c0 -> QNeq h a c

-- So names of different numbers are provably different.
define NamesNeq h a n = Nat a and forall c k. Names h c k -> not (Eq n k) -> QNeq h a c

theorem names_neq:
  assume q:     QCtx
  assume names: NAMES
  assume linv:  NamesLeast NamesInv
  assume least: NamesLeast NamesNeq
  fs0: FS0                                by and_e q
  nu:  Nu                                 by and_e fs0
  inv: forall h z j. Names h z j -> NamesInv h z j
                                          by imp_e names_inv names linv
  lemma c0:
    variable h a n
    assume na: Nat a
    assume nn: Nil n
    assume qa: QZero h a
    lemma each:
      variable c k
      assume nc:  Names h c k
      assume nek: not (Eq n k)
      ic:  NamesInv h c k                 by imp_e inv nc
      sh:  NamesShape h c k               by and_e ic
      ncv: Nat c                          by and_e sh
      o:   (Nil k and QZero h c) or (exists z0 j0. Names h z0 j0 and Nat z0 and Suc j0 k and QSucc h z0 c)
                                          by and_e sh
      lemma zero:
        assume b: Nil k and QZero h c
        nk: Nil k                         by and_e b
        e:  Eq n k                        by imp_e nu nn nk
        f:  absurd                        by imp_e nek e
        r:  QNeq h a c                    by absurd_e f
        therefore (Nil k and QZero h c) -> QNeq h a c
      lemma succ:
        assume ex: exists z0 j0. Names h z0 j0 and Nat z0 and Suc j0 k and QSucc h z0 c
        lemma wit:
          variable z0 j0
          assume hw: Names h z0 j0 and Nat z0 and Suc j0 k and QSucc h z0 c
          nz0: Nat z0                     by and_e hw
          qc:  QSucc h z0 c               by and_e hw
          r:   QNeq h a c                 by imp_e neq_zero_succ q na nz0 ncv qa qc
          therefore forall z0 j0. (Names h z0 j0 and Nat z0 and Suc j0 k and QSucc h z0 c) -> QNeq h a c
        r: QNeq h a c                     by exists_e ex wit
        therefore (exists z0 j0. Names h z0 j0 and Nat z0 and Suc j0 k and QSucc h z0 c) -> QNeq h a c
      r: QNeq h a c                       by or_e o zero succ
      therefore forall c k. Names h c k -> not (Eq n k) -> QNeq h a c
    r: NamesNeq h a n                     by and_i na each
    therefore forall h a n. Nat a -> Nil n -> QZero h a -> NamesNeq h a n
  lemma c1:
    variable h a n a1 n1
    assume ih:  NamesNeq h a n
    assume na1: Nat a1
    assume sn:  Suc n n1
    assume qs:  QSucc h a a1
    na: Nat a                             by and_e ih
    ihe: forall c k. Names h c k -> not (Eq n k) -> QNeq h a c
                                          by and_e ih
    lemma each:
      variable c k
      assume nc:  Names h c k
      assume nek: not (Eq n1 k)
      ic:  NamesInv h c k                 by imp_e inv nc
      sh:  NamesShape h c k               by and_e ic
      ncv: Nat c                          by and_e sh
      o:   (Nil k and QZero h c) or (exists z0 j0. Names h z0 j0 and Nat z0 and Suc j0 k and QSucc h z0 c)
                                          by and_e sh
      lemma zero:
        assume b: Nil k and QZero h c
        qz: QZero h c                     by and_e b
        r:  QNeq h a1 c                   by imp_e neq_succ_zero q na na1 ncv qs qz
        therefore (Nil k and QZero h c) -> QNeq h a1 c
      lemma succ:
        assume ex: exists z0 j0. Names h z0 j0 and Nat z0 and Suc j0 k and QSucc h z0 c
        lemma wit:
          variable z0 j0
          assume hw: Names h z0 j0 and Nat z0 and Suc j0 k and QSucc h z0 c
          n0:  Names h z0 j0              by and_e hw
          nz0: Nat z0                     by and_e hw
          sj:  Suc j0 k                   by and_e hw
          qc:  QSucc h z0 c               by and_e hw
          lemma nej:
            assume e: Eq n j0
            e1: Eq n1 k                   by imp_e suc_fun fs0 e sn sj
            f:  absurd                    by imp_e nek e1
            therefore not (Eq n j0)
          q0: QNeq h a z0                 by imp_e ihe n0 nej
          r:  QNeq h a1 c                 by imp_e neq_succ_succ q na na1 nz0 ncv qs qc q0
          therefore forall z0 j0. (Names h z0 j0 and Nat z0 and Suc j0 k and QSucc h z0 c) -> QNeq h a1 c
        r: QNeq h a1 c                    by exists_e ex wit
        therefore (exists z0 j0. Names h z0 j0 and Nat z0 and Suc j0 k and QSucc h z0 c) -> QNeq h a1 c
      r: QNeq h a1 c                      by or_e o zero succ
      therefore forall c k. Names h c k -> not (Eq n1 k) -> QNeq h a1 c
    r: NamesNeq h a1 n1                   by and_i na1 each
    therefore forall h a n a1 n1. NamesNeq h a n -> Nat a1 -> Suc n n1 -> QSucc h a a1 -> NamesNeq h a1 n1
  r: forall h z j. Names h z j -> NamesNeq h z j
                                          by imp_e least c0 c1
  therefore QCtx -> NAMES -> NamesLeast NamesInv -> NamesLeast NamesNeq -> forall h z j. Names h z j -> NamesNeq h z j

-- Modus ponens through QI.
theorem qi_mp:
  assume fs0: FS0
  assume prf: PRF QAx
  lemma all:
    variable h a b
    assume fb: Form b
    assume q:  QI h a b
    assume pa: PrH h a
    lemma wit:
      variable c
      assume k: ImpCode a b c and PrH h c
      ic: ImpCode a b c                   by and_e k
      pc: PrH h c                         by and_e k
      r:  PrH h b                         by imp_e prh_mp QAx fs0 prf fb ic pc pa
      therefore forall c. (ImpCode a b c and PrH h c) -> PrH h b
    r: PrH h b                            by exists_e q wit
    therefore forall h a b. Form b -> QI h a b -> PrH h a -> PrH h b
  therefore FS0 -> PRF QAx -> forall h a b. Form b -> QI h a b -> PrH h a -> PrH h b

-- QI names any code of the implication.
theorem qi_code:
  assume fs0: FS0
  assume prf: PRF QAx
  refl: Refl                              by and_e fs0
  lemma all:
    variable h a b x
    assume q:  QI h a b
    assume ix: ImpCode a b x
    ra: Eq a a                            by forall_e refl a
    rb: Eq b b                            by forall_e refl b
    lemma wit:
      variable c
      assume k: ImpCode a b c and PrH h c
      ic: ImpCode a b c                   by and_e k
      pc: PrH h c                         by and_e k
      e:  Eq c x                          by imp_e imp_fun fs0 ic ix ra rb
      r:  PrH h x                         by imp_e prh_eq QAx fs0 prf pc e
      therefore forall c. (ImpCode a b c and PrH h c) -> PrH h x
    r: PrH h x                            by exists_e q wit
    therefore forall h a b x. QI h a b -> ImpCode a b x -> PrH h x
  therefore FS0 -> PRF QAx -> forall h a b x. QI h a b -> ImpCode a b x -> PrH h x

-- The deduction theorem, into QI: what a :: h proves, h proves under a.
theorem qi_ded:
  assume fs0:   FS0
  assume form:  FORM
  assume logax: LOGAX
  assume list:  LIST
  assume prf:   PRF QAx
  assume dtp:   PrfLeast QAx DTP
  assume mc:    MemLeast MemCons
  lemma all:
    variable hh a h b
    assume ph: Pair a h hh
    assume fa: Form a
    assume fb: Form b
    assume pb: PrH hh b
    e: exists x. Form x and Node2 T2 a b x
                                          by imp_e imp_exists form fa fb
    lemma wit:
      variable ab
      assume k: Form ab and Node2 T2 a b ab
      iab: ImpCode a b ab                 by and_e k
      p:   PrH h ab                       by imp_e deduction QAx fs0 form logax list prf dtp mc ph fa iab pb
      c:   ImpCode a b ab and PrH h ab    by and_i iab p
      r:   QI h a b                       by exists_i c
      therefore forall ab. (Form ab and Node2 T2 a b ab) -> QI h a b
    r: QI h a b                           by exists_e e wit
    therefore forall hh a h b. Pair a h hh -> Form a -> Form b -> PrH hh b -> QI h a b
  therefore FS0 -> FORM -> LOGAX -> LIST -> PRF QAx -> PrfLeast QAx DTP -> MemLeast MemCons
              -> forall hh a h b. Pair a h hh -> Form a -> Form b -> PrH hh b -> QI h a b

-- The deduction theorem once more, under an implication already in QI.
theorem qi_ded2:
  assume fs0:   FS0
  assume form:  FORM
  assume logax: LOGAX
  assume list:  LIST
  assume prf:   PRF QAx
  assume dtp:   PrfLeast QAx DTP
  assume mc:    MemLeast MemCons
  fim: Fim                                by and_e form
  lemma all:
    variable hh a h b c
    assume ph: Pair a h hh
    assume fa: Form a
    assume fb: Form b
    assume fc: Form c
    assume q:  QI hh b c
    lemma wit:
      variable bc
      assume k: ImpCode b c bc and PrH hh bc
      ibc: ImpCode b c bc                 by and_e k
      pbc: PrH hh bc                      by and_e k
      fbc: Form bc                        by imp_e fim fb fc ibc
      qa:  QI h a bc                      by imp_e qi_ded fs0 form logax list prf dtp mc ph fa fbc pbc
      t:   ImpCode b c bc and QI h a bc   by and_i ibc qa
      r:   QI2 h a b c                    by exists_i t
      therefore forall bc. (ImpCode b c bc and PrH hh bc) -> QI2 h a b c
    r: QI2 h a b c                        by exists_e q wit
    therefore forall hh a h b c. Pair a h hh -> Form a -> Form b -> Form c -> QI hh b c -> QI2 h a b c
  therefore FS0 -> FORM -> LOGAX -> LIST -> PRF QAx -> PrfLeast QAx DTP -> MemLeast MemCons
              -> forall hh a h b c. Pair a h hh -> Form a -> Form b -> Form c -> QI hh b c -> QI2 h a b c

-- Every formula has a negation, and it is a formula.
theorem not_exists:
  assume fs0:  FS0
  assume form: FORM
  lemma all:
    variable a
    assume fa: Form a
    ez: exists z. BotCode z               by imp_e bot_exists fs0
    lemma wz:
      variable z
      assume bz: BotCode z
      fz: Form z                          by imp_e bot_form form bz
      en: exists x. Form x and Node2 T2 a z x
                                          by imp_e imp_exists form fa fz
      lemma wn:
        variable n
        assume k: Form n and Node2 T2 a z n
        fn:  Form n                       by and_e k
        in:  ImpCode a z n                by and_e k
        bn:  BotCode z and ImpCode a z n  by and_i bz in
        nc:  NotCode a n                  by exists_i bn
        t:   NotCode a n and Form n       by and_i nc fn
        r:   exists n1. NotCode a n1 and Form n1
                                          by exists_i t
        therefore forall n. (Form n and Node2 T2 a z n) -> exists n1. NotCode a n1 and Form n1
      r: exists n. NotCode a n and Form n by exists_e en wn
      therefore forall z. BotCode z -> exists n. NotCode a n and Form n
    r: exists n. NotCode a n and Form n   by exists_e ez wz
    therefore forall a. Form a -> exists n. NotCode a n and Form n
  therefore FS0 -> FORM -> forall a. Form a -> exists n. NotCode a n and Form n
