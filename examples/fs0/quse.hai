-- Q's axioms in use. Each lemma takes an axiom at given variables and, by modus ponens, its
-- antecedents, so a caller never builds an axiom's code. The `_pre` lemmas stop before the last
-- antecedents, for callers that need the implication itself. Generated, and checked like
-- everything else.
import sigma

-- What is provable is a formula.
theorem prh_form:
  predicate Ax x
  variable h a
  assume form: FORM
  assume pfl:  PrfLeast Ax PFormP
  assume pa:   PrH h a
  all: forall h1 d a1. Prf h1 d a1 -> PFormP h1 d a1
                                          by imp_e prf_form Ax form pfl
  lemma wit:
    variable d
    assume p: Prf h d a
    r: Form a                             by imp_e all p
    therefore forall d. Prf h d a -> Form a
  r: Form a                               by exists_e pa wit
  therefore forall h a. FORM -> PrfLeast Ax PFormP -> PrH h a -> Form a

-- An axiom is provable from any hypotheses.
theorem prh_axiom:
  predicate Ax x
  assume fs0: FS0
  assume prf: PRF Ax
  leaf: (forall h a. Form a -> LogAx a -> PrH h a) and (forall h a. Form a -> Ax a -> PrH h a)
          and (forall h a. Form a -> Mem a h -> PrH h a)
                                          by imp_e prh_leaf Ax fs0 prf
  r:    forall h a. Form a -> Ax a -> PrH h a
                                          by and_e leaf
  therefore FS0 -> PRF Ax -> forall h a. Form a -> Ax a -> PrH h a

-- An implication chain a1 -> ... -> an -> c of formulas has its codes, and they are formulas.
theorem imp2_exists:
  assume form: FORM
  lemma all:
    variable a1 a2 c
    assume f1: Form a1
    assume f2: Form a2
    assume fc: Form c
    e: exists x2. Form x2 and ImpCode a2 c x2
                                          by imp_e imp_exists form f2 fc
    lemma tail:
      variable x2
      assume t: Form x2 and Node2 T2 a2 c x2
      fx2: Form x2                        by and_e t
      e1:  exists x1. Form x1 and Node2 T2 a1 x2 x1
                                          by imp_e imp_exists form f1 fx2
      lemma head:
        variable x1
        assume h: Form x1 and Node2 T2 a1 x2 x1
        hf: Form x1                       by and_e h
        hi: ImpCode a1 x2 x1              by and_e h
        k:  Form x1 and ImpCode a1 x2 x1 and Form x2 and ImpCode a2 c x2
                                          by and_i hf hi t
        r:  exists x3 x4. Form x3 and ImpCode a1 x4 x3 and Form x4 and ImpCode a2 c x4
                                          by exists_i k
        therefore forall x1. (Form x1 and Node2 T2 a1 x2 x1)
                    -> exists x3 x4. Form x3 and ImpCode a1 x4 x3 and Form x4 and ImpCode a2 c x4
      r: exists x1 x3. Form x1 and ImpCode a1 x3 x1 and Form x3 and ImpCode a2 c x3
                                          by exists_e e1 head
      therefore forall x2. (Form x2 and Node2 T2 a2 c x2)
                  -> exists x1 x3. Form x1 and ImpCode a1 x3 x1 and Form x3 and ImpCode a2 c x3
    r: exists x1 x2. Form x1 and ImpCode a1 x2 x1 and Form x2 and ImpCode a2 c x2
                                          by exists_e e tail
    therefore forall a1 a2 c. Form a1 -> Form a2 -> Form c
                -> exists x1 x2. Form x1 and ImpCode a1 x2 x1 and Form x2 and ImpCode a2 c x2
  therefore FORM -> forall a1 a2 c. Form a1 -> Form a2 -> Form c
              -> exists x1 x2. Form x1 and ImpCode a1 x2 x1 and Form x2 and ImpCode a2 c x2

theorem imp3_exists:
  assume form: FORM
  lemma all:
    variable a1 a2 a3 c
    assume f1: Form a1
    assume f2: Form a2
    assume f3: Form a3
    assume fc: Form c
    e: exists x2 x3. Form x2 and ImpCode a2 x3 x2 and Form x3 and ImpCode a3 c x3
                                          by imp_e imp2_exists form f2 f3 fc
    lemma tail:
      variable x2 x3
      assume t: Form x2 and ImpCode a2 x3 x2 and Form x3 and ImpCode a3 c x3
      fx2: Form x2                        by and_e t
      e1:  exists x1. Form x1 and Node2 T2 a1 x2 x1
                                          by imp_e imp_exists form f1 fx2
      lemma head:
        variable x1
        assume h: Form x1 and Node2 T2 a1 x2 x1
        hf: Form x1                       by and_e h
        hi: ImpCode a1 x2 x1              by and_e h
        k:  Form x1 and ImpCode a1 x2 x1 and Form x2 and ImpCode a2 x3 x2 and Form x3 and ImpCode a3 c x3
                                          by and_i hf hi t
        r:  exists x4 x5 x6. Form x4 and ImpCode a1 x5 x4 and Form x5 and ImpCode a2 x6 x5 and Form x6
              and ImpCode a3 c x6
                                          by exists_i k
        therefore forall x1. (Form x1 and Node2 T2 a1 x2 x1)
                    -> exists x4 x5 x6. Form x4 and ImpCode a1 x5 x4 and Form x5 and ImpCode a2 x6 x5 and Form x6 and ImpCode a3 c x6
      r: exists x1 x4 x5. Form x1 and ImpCode a1 x4 x1 and Form x4 and ImpCode a2 x5 x4 and Form x5
           and ImpCode a3 c x5
                                          by exists_e e1 head
      therefore forall x2 x3. (Form x2 and ImpCode a2 x3 x2 and Form x3 and ImpCode a3 c x3)
                  -> exists x1 x4 x5. Form x1 and ImpCode a1 x4 x1 and Form x4 and ImpCode a2 x5 x4 and Form x5 and ImpCode a3 c x5
    r: exists x1 x2 x3. Form x1 and ImpCode a1 x2 x1 and Form x2 and ImpCode a2 x3 x2 and Form x3
         and ImpCode a3 c x3
                                          by exists_e e tail
    therefore forall a1 a2 a3 c. Form a1 -> Form a2 -> Form a3 -> Form c
                -> exists x1 x2 x3. Form x1 and ImpCode a1 x2 x1 and Form x2 and ImpCode a2 x3 x2 and Form x3 and ImpCode a3 c x3
  therefore FORM -> forall a1 a2 a3 c. Form a1 -> Form a2 -> Form a3 -> Form c
              -> exists x1 x2 x3. Form x1 and ImpCode a1 x2 x1 and Form x2 and ImpCode a2 x3 x2 and Form x3 and ImpCode a3 c x3

theorem imp4_exists:
  assume form: FORM
  lemma all:
    variable a1 a2 a3 a4 c
    assume f1: Form a1
    assume f2: Form a2
    assume f3: Form a3
    assume f4: Form a4
    assume fc: Form c
    e: exists x2 x3 x4. Form x2 and ImpCode a2 x3 x2 and Form x3 and ImpCode a3 x4 x3 and Form x4
         and ImpCode a4 c x4
                                          by imp_e imp3_exists form f2 f3 f4 fc
    lemma tail:
      variable x2 x3 x4
      assume t: Form x2 and ImpCode a2 x3 x2 and Form x3 and ImpCode a3 x4 x3 and Form x4 and ImpCode a4 c x4
      fx2: Form x2                        by and_e t
      e1:  exists x1. Form x1 and Node2 T2 a1 x2 x1
                                          by imp_e imp_exists form f1 fx2
      lemma head:
        variable x1
        assume h: Form x1 and Node2 T2 a1 x2 x1
        hf: Form x1                       by and_e h
        hi: ImpCode a1 x2 x1              by and_e h
        k:  Form x1 and ImpCode a1 x2 x1 and Form x2 and ImpCode a2 x3 x2 and Form x3 and ImpCode a3 x4 x3
              and Form x4 and ImpCode a4 c x4
                                          by and_i hf hi t
        r:  exists x5 x6 x7 x8. Form x5 and ImpCode a1 x6 x5 and Form x6 and ImpCode a2 x7 x6 and Form x7
              and ImpCode a3 x8 x7 and Form x8 and ImpCode a4 c x8
                                          by exists_i k
        therefore forall x1. (Form x1 and Node2 T2 a1 x2 x1)
                    -> exists x5 x6 x7 x8. Form x5 and ImpCode a1 x6 x5 and Form x6 and ImpCode a2 x7 x6 and Form x7 and ImpCode a3 x8 x7 and Form x8 and ImpCode a4 c x8
      r: exists x1 x5 x6 x7. Form x1 and ImpCode a1 x5 x1 and Form x5 and ImpCode a2 x6 x5 and Form x6
           and ImpCode a3 x7 x6 and Form x7 and ImpCode a4 c x7
                                          by exists_e e1 head
      therefore forall x2 x3 x4. (Form x2 and ImpCode a2 x3 x2 and Form x3 and ImpCode a3 x4 x3 and Form x4 and ImpCode a4 c x4)
                  -> exists x1 x5 x6 x7. Form x1 and ImpCode a1 x5 x1 and Form x5 and ImpCode a2 x6 x5 and Form x6 and ImpCode a3 x7 x6 and Form x7 and ImpCode a4 c x7
    r: exists x1 x2 x3 x4. Form x1 and ImpCode a1 x2 x1 and Form x2 and ImpCode a2 x3 x2 and Form x3
         and ImpCode a3 x4 x3 and Form x4 and ImpCode a4 c x4
                                          by exists_e e tail
    therefore forall a1 a2 a3 a4 c. Form a1 -> Form a2 -> Form a3 -> Form a4 -> Form c
                -> exists x1 x2 x3 x4. Form x1 and ImpCode a1 x2 x1 and Form x2 and ImpCode a2 x3 x2 and Form x3 and ImpCode a3 x4 x3 and Form x4 and ImpCode a4 c x4
  therefore FORM -> forall a1 a2 a3 a4 c. Form a1 -> Form a2 -> Form a3 -> Form a4 -> Form c
              -> exists x1 x2 x3 x4. Form x1 and ImpCode a1 x2 x1 and Form x2 and ImpCode a2 x3 x2 and Form x3 and ImpCode a3 x4 x3 and Form x4 and ImpCode a4 c x4

-- Sz: forall x y. Succ x y -> not (Zero y)
theorem q_sz:
  assume fs0:  FS0
  assume form: FORM
  assume prf:  PRF QAx
  assume pfl:  PrfLeast QAx PFormP
  lemma all:
    variable h v0 v1 c3 c4 c5
    assume n0:  Nat v0
    assume n1:  Nat v1
    assume k0:  NotCode c5 c4
    assume k1:  ZeroAt v1 c5
    assume k2:  SuccAt v0 v1 c3
    assume p0:  PrH h c3
    assume fc4: Form c4
    fc3: Form c3                          by imp_e prh_form QAx form pfl p0
    e:   exists c2. Form c2 and Node2 T2 c3 c4 c2
                                          by imp_e imp_exists form fc3 fc4
    lemma code:
      variable c2
      assume c: Form c2 and Node2 T2 c3 c4 c2
      fc2: Form c2                        by and_e c
      ic2: ImpCode c3 c4 c2               by and_e c
      kx:  Nat v0 and Nat v1 and ImpCode c3 c4 c2 and NotCode c5 c4 and ZeroAt v1 c5 and SuccAt v0 v1 c3
                                          by and_i n0 n1 ic2 k0 k1 k2
      cx:  SzCode c2                      by exists_i kx
      qx:  QAx c2                         by or_i cx
      pc2: PrH h c2                       by imp_e prh_axiom QAx fs0 prf fc2 qx
      pc4: PrH h c4                       by imp_e prh_mp QAx fs0 prf fc4 ic2 pc2 p0
      therefore forall c2. (Form c2 and Node2 T2 c3 c4 c2) -> PrH h c4
    r: PrH h c4                           by exists_e e code
    therefore forall h v0 v1 c3 c4 c5. Nat v0 -> Nat v1 -> NotCode c5 c4 -> ZeroAt v1 c5 -> SuccAt v0 v1 c3
                -> PrH h c3 -> Form c4 -> PrH h c4
  therefore FS0 -> FORM -> PRF QAx -> PrfLeast QAx PFormP -> forall h v0 v1 c3 c4 c5. Nat v0 -> Nat v1
              -> NotCode c5 c4 -> ZeroAt v1 c5 -> SuccAt v0 v1 c3 -> PrH h c3 -> Form c4 -> PrH h c4

-- Si: forall x y a b. Succ x a -> Succ y b -> Eq a b -> Eq x y
theorem q_si:
  assume fs0:  FS0
  assume form: FORM
  assume prf:  PRF QAx
  assume pfl:  PrfLeast QAx PFormP
  lemma all:
    variable h v0 v1 v2 v3 c5 c7 c9 c10
    assume n0:   Nat v0
    assume n1:   Nat v1
    assume n2:   Nat v2
    assume n3:   Nat v3
    assume k0:   EqAt v0 v1 c10
    assume k1:   EqAt v2 v3 c9
    assume k2:   SuccAt v1 v3 c7
    assume k3:   SuccAt v0 v2 c5
    assume p0:   PrH h c5
    assume p1:   PrH h c7
    assume p2:   PrH h c9
    assume fc10: Form c10
    fc5: Form c5                          by imp_e prh_form QAx form pfl p0
    fc7: Form c7                          by imp_e prh_form QAx form pfl p1
    fc9: Form c9                          by imp_e prh_form QAx form pfl p2
    e:   exists c4 c6 c8. Form c4 and ImpCode c5 c6 c4 and Form c6 and ImpCode c7 c8 c6 and Form c8
           and ImpCode c9 c10 c8
                                          by imp_e imp3_exists form fc5 fc7 fc9 fc10
    lemma code:
      variable c4 c6 c8
      assume c: Form c4 and ImpCode c5 c6 c4 and Form c6 and ImpCode c7 c8 c6 and Form c8 and ImpCode c9 c10 c8
      fc4:  Form c4                       by and_e c
      ic4:  ImpCode c5 c6 c4              by and_e c
      fc6:  Form c6                       by and_e c
      ic6:  ImpCode c7 c8 c6              by and_e c
      fc8:  Form c8                       by and_e c
      ic8:  ImpCode c9 c10 c8             by and_e c
      kx:   Nat v0 and Nat v1 and Nat v2 and Nat v3 and ImpCode c5 c6 c4 and ImpCode c7 c8 c6
              and ImpCode c9 c10 c8 and EqAt v0 v1 c10 and EqAt v2 v3 c9 and SuccAt v1 v3 c7
              and SuccAt v0 v2 c5
                                          by and_i n0 n1 n2 n3 ic4 ic6 ic8 k0 k1 k2 k3
      cx:   SiCode c4                     by exists_i kx
      qx:   QAx c4                        by or_i cx
      pc4:  PrH h c4                      by imp_e prh_axiom QAx fs0 prf fc4 qx
      pc6:  PrH h c6                      by imp_e prh_mp QAx fs0 prf fc6 ic4 pc4 p0
      pc8:  PrH h c8                      by imp_e prh_mp QAx fs0 prf fc8 ic6 pc6 p1
      pc10: PrH h c10                     by imp_e prh_mp QAx fs0 prf fc10 ic8 pc8 p2
      therefore forall c4 c6 c8. (Form c4 and ImpCode c5 c6 c4 and Form c6 and ImpCode c7 c8 c6 and Form c8 and ImpCode c9 c10 c8)
                  -> PrH h c10
    r: PrH h c10                          by exists_e e code
    therefore forall h v0 v1 v2 v3 c5 c7 c9 c10. Nat v0 -> Nat v1 -> Nat v2 -> Nat v3 -> EqAt v0 v1 c10
                -> EqAt v2 v3 c9 -> SuccAt v1 v3 c7 -> SuccAt v0 v2 c5 -> PrH h c5 -> PrH h c7 -> PrH h c9
                -> Form c10 -> PrH h c10
  therefore FS0 -> FORM -> PRF QAx -> PrfLeast QAx PFormP -> forall h v0 v1 v2 v3 c5 c7 c9 c10. Nat v0
              -> Nat v1 -> Nat v2 -> Nat v3 -> EqAt v0 v1 c10 -> EqAt v2 v3 c9 -> SuccAt v1 v3 c7
              -> SuccAt v0 v2 c5 -> PrH h c5 -> PrH h c7 -> PrH h c9 -> Form c10 -> PrH h c10

-- Pz: forall x z. Zero z -> Plus x z x
theorem q_pz:
  assume fs0:  FS0
  assume form: FORM
  assume prf:  PRF QAx
  assume pfl:  PrfLeast QAx PFormP
  lemma all:
    variable h v0 v1 c3 c4
    assume n0:  Nat v0
    assume n1:  Nat v1
    assume k0:  PlusAt v0 v1 v0 c4
    assume k1:  ZeroAt v1 c3
    assume p0:  PrH h c3
    assume fc4: Form c4
    fc3: Form c3                          by imp_e prh_form QAx form pfl p0
    e:   exists c2. Form c2 and Node2 T2 c3 c4 c2
                                          by imp_e imp_exists form fc3 fc4
    lemma code:
      variable c2
      assume c: Form c2 and Node2 T2 c3 c4 c2
      fc2: Form c2                        by and_e c
      ic2: ImpCode c3 c4 c2               by and_e c
      kx:  Nat v0 and Nat v1 and ImpCode c3 c4 c2 and PlusAt v0 v1 v0 c4 and ZeroAt v1 c3
                                          by and_i n0 n1 ic2 k0 k1
      cx:  PzCode c2                      by exists_i kx
      qx:  QAx c2                         by or_i cx
      pc2: PrH h c2                       by imp_e prh_axiom QAx fs0 prf fc2 qx
      pc4: PrH h c4                       by imp_e prh_mp QAx fs0 prf fc4 ic2 pc2 p0
      therefore forall c2. (Form c2 and Node2 T2 c3 c4 c2) -> PrH h c4
    r: PrH h c4                           by exists_e e code
    therefore forall h v0 v1 c3 c4. Nat v0 -> Nat v1 -> PlusAt v0 v1 v0 c4 -> ZeroAt v1 c3 -> PrH h c3
                -> Form c4 -> PrH h c4
  therefore FS0 -> FORM -> PRF QAx -> PrfLeast QAx PFormP -> forall h v0 v1 c3 c4. Nat v0 -> Nat v1
              -> PlusAt v0 v1 v0 c4 -> ZeroAt v1 c3 -> PrH h c3 -> Form c4 -> PrH h c4

-- Ps: forall x y s p q. Succ y s -> Plus x y p -> Succ p q -> Plus x s q
theorem q_ps:
  assume fs0:  FS0
  assume form: FORM
  assume prf:  PRF QAx
  assume pfl:  PrfLeast QAx PFormP
  lemma all:
    variable h v0 v1 v2 v3 v4 c6 c8 c10 c11
    assume n0:   Nat v0
    assume n1:   Nat v1
    assume n2:   Nat v2
    assume n3:   Nat v3
    assume n4:   Nat v4
    assume k0:   PlusAt v0 v2 v4 c11
    assume k1:   SuccAt v3 v4 c10
    assume k2:   PlusAt v0 v1 v3 c8
    assume k3:   SuccAt v1 v2 c6
    assume p0:   PrH h c6
    assume p1:   PrH h c8
    assume p2:   PrH h c10
    assume fc11: Form c11
    fc6:  Form c6                         by imp_e prh_form QAx form pfl p0
    fc8:  Form c8                         by imp_e prh_form QAx form pfl p1
    fc10: Form c10                        by imp_e prh_form QAx form pfl p2
    e:    exists c5 c7 c9. Form c5 and ImpCode c6 c7 c5 and Form c7 and ImpCode c8 c9 c7 and Form c9
            and ImpCode c10 c11 c9
                                          by imp_e imp3_exists form fc6 fc8 fc10 fc11
    lemma code:
      variable c5 c7 c9
      assume c: Form c5 and ImpCode c6 c7 c5 and Form c7 and ImpCode c8 c9 c7 and Form c9 and ImpCode c10 c11 c9
      fc5:  Form c5                       by and_e c
      ic5:  ImpCode c6 c7 c5              by and_e c
      fc7:  Form c7                       by and_e c
      ic7:  ImpCode c8 c9 c7              by and_e c
      fc9:  Form c9                       by and_e c
      ic9:  ImpCode c10 c11 c9            by and_e c
      kx:   Nat v0 and Nat v1 and Nat v2 and Nat v3 and Nat v4 and ImpCode c6 c7 c5 and ImpCode c8 c9 c7
              and ImpCode c10 c11 c9 and PlusAt v0 v2 v4 c11 and SuccAt v3 v4 c10 and PlusAt v0 v1 v3 c8
              and SuccAt v1 v2 c6
                                          by and_i n0 n1 n2 n3 n4 ic5 ic7 ic9 k0 k1 k2 k3
      cx:   PsCode c5                     by exists_i kx
      qx:   QAx c5                        by or_i cx
      pc5:  PrH h c5                      by imp_e prh_axiom QAx fs0 prf fc5 qx
      pc7:  PrH h c7                      by imp_e prh_mp QAx fs0 prf fc7 ic5 pc5 p0
      pc9:  PrH h c9                      by imp_e prh_mp QAx fs0 prf fc9 ic7 pc7 p1
      pc11: PrH h c11                     by imp_e prh_mp QAx fs0 prf fc11 ic9 pc9 p2
      therefore forall c5 c7 c9. (Form c5 and ImpCode c6 c7 c5 and Form c7 and ImpCode c8 c9 c7 and Form c9 and ImpCode c10 c11 c9)
                  -> PrH h c11
    r: PrH h c11                          by exists_e e code
    therefore forall h v0 v1 v2 v3 v4 c6 c8 c10 c11. Nat v0 -> Nat v1 -> Nat v2 -> Nat v3 -> Nat v4
                -> PlusAt v0 v2 v4 c11 -> SuccAt v3 v4 c10 -> PlusAt v0 v1 v3 c8 -> SuccAt v1 v2 c6 -> PrH h c6
                -> PrH h c8 -> PrH h c10 -> Form c11 -> PrH h c11
  therefore FS0 -> FORM -> PRF QAx -> PrfLeast QAx PFormP -> forall h v0 v1 v2 v3 v4 c6 c8 c10 c11. Nat v0
              -> Nat v1 -> Nat v2 -> Nat v3 -> Nat v4 -> PlusAt v0 v2 v4 c11 -> SuccAt v3 v4 c10
              -> PlusAt v0 v1 v3 c8 -> SuccAt v1 v2 c6 -> PrH h c6 -> PrH h c8 -> PrH h c10 -> Form c11
              -> PrH h c11

-- Tz: forall x z. Zero z -> Times x z z
theorem q_tz:
  assume fs0:  FS0
  assume form: FORM
  assume prf:  PRF QAx
  assume pfl:  PrfLeast QAx PFormP
  lemma all:
    variable h v0 v1 c3 c4
    assume n0:  Nat v0
    assume n1:  Nat v1
    assume k0:  TimesAt v0 v1 v1 c4
    assume k1:  ZeroAt v1 c3
    assume p0:  PrH h c3
    assume fc4: Form c4
    fc3: Form c3                          by imp_e prh_form QAx form pfl p0
    e:   exists c2. Form c2 and Node2 T2 c3 c4 c2
                                          by imp_e imp_exists form fc3 fc4
    lemma code:
      variable c2
      assume c: Form c2 and Node2 T2 c3 c4 c2
      fc2: Form c2                        by and_e c
      ic2: ImpCode c3 c4 c2               by and_e c
      kx:  Nat v0 and Nat v1 and ImpCode c3 c4 c2 and TimesAt v0 v1 v1 c4 and ZeroAt v1 c3
                                          by and_i n0 n1 ic2 k0 k1
      cx:  TzCode c2                      by exists_i kx
      qx:  QAx c2                         by or_i cx
      pc2: PrH h c2                       by imp_e prh_axiom QAx fs0 prf fc2 qx
      pc4: PrH h c4                       by imp_e prh_mp QAx fs0 prf fc4 ic2 pc2 p0
      therefore forall c2. (Form c2 and Node2 T2 c3 c4 c2) -> PrH h c4
    r: PrH h c4                           by exists_e e code
    therefore forall h v0 v1 c3 c4. Nat v0 -> Nat v1 -> TimesAt v0 v1 v1 c4 -> ZeroAt v1 c3 -> PrH h c3
                -> Form c4 -> PrH h c4
  therefore FS0 -> FORM -> PRF QAx -> PrfLeast QAx PFormP -> forall h v0 v1 c3 c4. Nat v0 -> Nat v1
              -> TimesAt v0 v1 v1 c4 -> ZeroAt v1 c3 -> PrH h c3 -> Form c4 -> PrH h c4

-- Ts: forall x y s p q. Succ y s -> Times x y p -> Plus p x q -> Times x s q
theorem q_ts:
  assume fs0:  FS0
  assume form: FORM
  assume prf:  PRF QAx
  assume pfl:  PrfLeast QAx PFormP
  lemma all:
    variable h v0 v1 v2 v3 v4 c6 c8 c10 c11
    assume n0:   Nat v0
    assume n1:   Nat v1
    assume n2:   Nat v2
    assume n3:   Nat v3
    assume n4:   Nat v4
    assume k0:   TimesAt v0 v2 v4 c11
    assume k1:   PlusAt v3 v0 v4 c10
    assume k2:   TimesAt v0 v1 v3 c8
    assume k3:   SuccAt v1 v2 c6
    assume p0:   PrH h c6
    assume p1:   PrH h c8
    assume p2:   PrH h c10
    assume fc11: Form c11
    fc6:  Form c6                         by imp_e prh_form QAx form pfl p0
    fc8:  Form c8                         by imp_e prh_form QAx form pfl p1
    fc10: Form c10                        by imp_e prh_form QAx form pfl p2
    e:    exists c5 c7 c9. Form c5 and ImpCode c6 c7 c5 and Form c7 and ImpCode c8 c9 c7 and Form c9
            and ImpCode c10 c11 c9
                                          by imp_e imp3_exists form fc6 fc8 fc10 fc11
    lemma code:
      variable c5 c7 c9
      assume c: Form c5 and ImpCode c6 c7 c5 and Form c7 and ImpCode c8 c9 c7 and Form c9 and ImpCode c10 c11 c9
      fc5:  Form c5                       by and_e c
