-- Clean formulas: no quantifier binds a variable already bound around it. Sigma1-completeness
-- needs it, because the existential case adds a hypothesis mentioning the bound variable, which
-- must then be free nowhere else a quantifier is introduced. The arithmetic formulas this is
-- used for are built clean.

import sigma

predicate Clean x

define Cat  = forall p l x. Node2 T1 p l x -> Clean x
define Cbot = forall n x. Nil n -> Node1 T0 n x -> Clean x
define Cbin = forall a b x. Clean a -> Clean b -> BinNode a b x -> Clean x
define Cq   = forall v a x. Clean a -> not (Bound v a) -> QNode v a x -> Clean x
define Qcl  = forall x x1. Eq x x1 -> Clean x -> Clean x1

define CLEAN = Cat and Cbot and Cbin and Cq and Qcl

define CleanLeast (P x) = (forall p l x. Node2 T1 p l x -> P x)
    -> (forall n x. Nil n -> Node1 T0 n x -> P x)
    -> (forall a b x. P a -> P b -> Clean a -> Clean b -> BinNode a b x -> P x)
    -> (forall v a x. P a -> Clean a -> not (Bound v a) -> QNode v a x -> P x)
    -> (forall x x1. Eq x x1 -> P x -> P x1)
    -> forall x. Clean x -> P x

define CleanShape x = (exists p l. Node2 T1 p l x) or (exists n. Nil n and Node1 T0 n x)
    or (exists a b. Clean a and Clean b and BinNode a b x)
    or (exists v a. Clean a and not (Bound v a) and QNode v a x)
define CleanInv x   = Clean x and CleanShape x

theorem clean_inv:
  assume fs0:   FS0
  assume clean: CLEAN
  assume least: CleanLeast CleanInv
  cat:  Cat  by and_e clean
  cbot: Cbot by and_e clean
  cbin: Cbin by and_e clean
  cq:   Cq   by and_e clean
  qcl:  Qcl  by and_e clean
  refl: Refl by and_e fs0
  lemma c_at:
    variable p l x
    assume nd: Node2 T1 p l x
    c:  Clean x                        by imp_e cat nd
    e:  exists p1 l1. Node2 T1 p1 l1 x by exists_i nd
    sh: CleanShape x                   by or_i e
    r:  CleanInv x                     by and_i c sh
    therefore forall p l x. Node2 T1 p l x -> CleanInv x
  lemma c_bot:
    variable n x
    assume nn: Nil n
    assume nd: Node1 T0 n x
    c:  Clean x                             by imp_e cbot nn nd
    k:  Nil n and Node1 T0 n x              by and_i nn nd
    e:  exists n1. Nil n1 and Node1 T0 n1 x by exists_i k
    sh: CleanShape x                        by or_i e
    r:  CleanInv x                          by and_i c sh
    therefore forall n x. Nil n -> Node1 T0 n x -> CleanInv x
  lemma c_bin:
    variable a b x
    assume ia: CleanInv a
    assume ib: CleanInv b
    assume ca: Clean a
    assume cb: Clean b
    assume bn: BinNode a b x
    c:  Clean x      by imp_e cbin ca cb bn
    k:  Clean a and Clean b and BinNode a b x
                     by and_i ca cb bn
    e:  exists a1 b1. Clean a1 and Clean b1 and BinNode a1 b1 x
                     by exists_i k
    sh: CleanShape x by or_i e
    r:  CleanInv x   by and_i c sh
    therefore forall a b x. CleanInv a -> CleanInv b -> Clean a -> Clean b -> BinNode a b x -> CleanInv x
  lemma c_q:
    variable v a x
    assume ia: CleanInv a
    assume ca: Clean a
    assume nb: not (Bound v a)
    assume qn: QNode v a x
    c:  Clean x      by imp_e cq ca nb qn
    k:  Clean a and not (Bound v a) and QNode v a x
                     by and_i ca nb qn
    e:  exists v1 a1. Clean a1 and not (Bound v1 a1) and QNode v1 a1 x
                     by exists_i k
    sh: CleanShape x by or_i e
    r:  CleanInv x   by and_i c sh
    therefore forall v a x. CleanInv a -> Clean a -> not (Bound v a) -> QNode v a x -> CleanInv x
  lemma c_eq:
    variable x x1
    assume ex: Eq x x1
    assume ih: CleanInv x
    cx: Clean x      by and_e ih
    c1: Clean x1     by imp_e qcl ex cx
    sh: CleanShape x by and_e ih
    lemma s_at:
      assume h: exists p l. Node2 T1 p l x
      lemma wit:
        variable p l
        assume nd: Node2 T1 p l x
        n1: Node2 T1 p l x1                 by imp_e node2_eq_right T1 fs0 nd ex
        e:  exists p1 l1. Node2 T1 p1 l1 x1 by exists_i n1
        r:  CleanShape x1                   by or_i e
        therefore forall p l. Node2 T1 p l x -> CleanShape x1
      r: CleanShape x1 by exists_e h wit
      therefore (exists p l. Node2 T1 p l x) -> CleanShape x1
    lemma s_bot:
      assume h: exists n. Nil n and Node1 T0 n x
      lemma wit:
        variable n
        assume hn: Nil n and Node1 T0 n x
        nn: Nil n        by and_e hn
        nd: Node1 T0 n x by and_e hn
        lemma w2:
          variable t
          assume ht: T0 t and Pair t n x
          tt: T0 t                    by and_e ht
          pt: Pair t n x              by and_e ht
          ep: Ep                      by and_e fs0
          rt: Eq t t                  by forall_e refl t
          rn: Eq n n                  by forall_e refl n
          p1: Pair t n x1             by imp_e ep rt rn ex pt
          k1: T0 t and Pair t n x1    by and_i tt p1
          d1: Node1 T0 n x1           by exists_i k1
          k:  Nil n and Node1 T0 n x1 by and_i nn d1
          e:  exists n1. Nil n1 and Node1 T0 n1 x1
                                      by exists_i k
          r:  CleanShape x1           by or_i e
          therefore forall t. (T0 t and Pair t n x) -> CleanShape x1
        r: CleanShape x1 by exists_e nd w2
        therefore forall n. (Nil n and Node1 T0 n x) -> CleanShape x1
      r: CleanShape x1 by exists_e h wit
      therefore (exists n. Nil n and Node1 T0 n x) -> CleanShape x1
    lemma s_bin:
      assume h: exists a b. Clean a and Clean b and BinNode a b x
      lemma wit:
        variable a b
        assume hb: Clean a and Clean b and BinNode a b x
        ca: Clean a        by and_e hb
        cb: Clean b        by and_e hb
        bn: BinNode a b x  by and_e hb
        b1: BinNode a b x1 by imp_e binnode_eq_right fs0 bn ex
        k:  Clean a and Clean b and BinNode a b x1
                           by and_i ca cb b1
        e:  exists a1 b2. Clean a1 and Clean b2 and BinNode a1 b2 x1
                           by exists_i k
        r:  CleanShape x1  by or_i e
        therefore forall a b. (Clean a and Clean b and BinNode a b x) -> CleanShape x1
      r: CleanShape x1 by exists_e h wit
      therefore (exists a b. Clean a and Clean b and BinNode a b x) -> CleanShape x1
    lemma s_q:
      assume h: exists v a. Clean a and not (Bound v a) and QNode v a x
      lemma wit:
        variable v a
        assume hq: Clean a and not (Bound v a) and QNode v a x
        ca: Clean a         by and_e hq
        nb: not (Bound v a) by and_e hq
        qn: QNode v a x     by and_e hq
        q1: QNode v a x1    by imp_e qnode_eq_right fs0 qn ex
        k:  Clean a and not (Bound v a) and QNode v a x1
                            by and_i ca nb q1
        e:  exists v1 a1. Clean a1 and not (Bound v1 a1) and QNode v1 a1 x1
                            by exists_i k
        r:  CleanShape x1   by or_i e
        therefore forall v a. (Clean a and not (Bound v a) and QNode v a x) -> CleanShape x1
      r: CleanShape x1 by exists_e h wit
      therefore (exists v a. Clean a and not (Bound v a) and QNode v a x) -> CleanShape x1
    s1: CleanShape x1 by or_e sh s_at s_bot s_bin s_q
    r:  CleanInv x1   by and_i c1 s1
    therefore forall x x1. Eq x x1 -> CleanInv x -> CleanInv x1
  r: forall x. Clean x -> CleanInv x by imp_e least c_at c_bot c_bin c_q c_eq
  therefore FS0 -> CLEAN -> CleanLeast CleanInv -> forall x. Clean x -> CleanInv x

-- So a clean quantifier's body is clean and does not bind its variable, and a clean
-- connective's parts are clean.
theorem clean_q:
  variable v a x
  assume fs0:   FS0
  assume clean: CLEAN
  assume bound: BOUND
  assume least: CleanLeast CleanInv
  assume cx:    Clean x
  assume qn:    QNode v a x
  qcl: Qcl                                by and_e clean
  qb:  Qb                                 by and_e bound
  inv: forall x1. Clean x1 -> CleanInv x1 by imp_e clean_inv fs0 clean least
  ix:  CleanInv x                         by imp_e inv cx
  sh:  CleanShape x                       by and_e ix
  lemma s_at:
    assume h: exists p l. Node2 T1 p l x
    lemma wit:
      variable p l
      assume nd: Node2 T1 p l x
      f: absurd                      by imp_e at_q_apart fs0 nd qn
      r: Clean a and not (Bound v a) by absurd_e f
      therefore forall p l. Node2 T1 p l x -> Clean a and not (Bound v a)
    r: Clean a and not (Bound v a) by exists_e h wit
    therefore (exists p l. Node2 T1 p l x) -> Clean a and not (Bound v a)
  lemma s_bot:
    assume h: exists n. Nil n and Node1 T0 n x
    lemma wit:
      variable n
      assume hn: Nil n and Node1 T0 n x
      nn: Nil n        by and_e hn
      nd: Node1 T0 n x by and_e hn
      lemma c5:
        assume m: Node2 T5 v a x
        f: absurd by imp_e node1_node2_apart T0 T5 fs0 nn nd m
        therefore Node2 T5 v a x -> absurd
      lemma c6:
        assume m: Node2 T6 v a x
        f: absurd by imp_e node1_node2_apart T0 T6 fs0 nn nd m
        therefore Node2 T6 v a x -> absurd
      f: absurd                      by or_e qn c5 c6
      r: Clean a and not (Bound v a) by absurd_e f
      therefore forall n. (Nil n and Node1 T0 n x) -> Clean a and not (Bound v a)
    r: Clean a and not (Bound v a) by exists_e h wit
    therefore (exists n. Nil n and Node1 T0 n x) -> Clean a and not (Bound v a)
  lemma s_bin:
    assume h: exists a1 b1. Clean a1 and Clean b1 and BinNode a1 b1 x
    lemma wit:
      variable a1 b1
      assume hb: Clean a1 and Clean b1 and BinNode a1 b1 x
      bn: BinNode a1 b1 x             by and_e hb
      f:  absurd                      by imp_e bin_q_apart fs0 bn qn
      r:  Clean a and not (Bound v a) by absurd_e f
      therefore forall a1 b1. (Clean a1 and Clean b1 and BinNode a1 b1 x) -> Clean a and not (Bound v a)
    r: Clean a and not (Bound v a) by exists_e h wit
    therefore (exists a1 b1. Clean a1 and Clean b1 and BinNode a1 b1 x) -> Clean a and not (Bound v a)
  lemma s_q:
    assume h: exists v1 a1. Clean a1 and not (Bound v1 a1) and QNode v1 a1 x
    lemma wit:
      variable v1 a1
      assume hq: Clean a1 and not (Bound v1 a1) and QNode v1 a1 x
      ca1: Clean a1            by and_e hq
      nb1: not (Bound v1 a1)   by and_e hq
      q1:  QNode v1 a1 x       by and_e hq
      e:   Eq v1 v and Eq a1 a by imp_e qnode_parts fs0 q1 qn
      ev:  Eq v1 v             by and_e e
      ea:  Eq a1 a             by and_e e
      ca:  Clean a             by imp_e qcl ea ca1
      ve:  Eq v v1             by imp_e eq_sym fs0 ev
      ae:  Eq a a1             by imp_e eq_sym fs0 ea
      lemma nb:
        assume b: Bound v a
        b1: Bound v1 a1 by imp_e qb ve ae b
        f:  absurd      by imp_e nb1 b1
        therefore not (Bound v a)
      r: Clean a and not (Bound v a) by and_i ca nb
      therefore forall v1 a1. (Clean a1 and not (Bound v1 a1) and QNode v1 a1 x) -> Clean a and not (Bound v a)
    r: Clean a and not (Bound v a) by exists_e h wit
    therefore (exists v1 a1. Clean a1 and not (Bound v1 a1) and QNode v1 a1 x) -> Clean a and not (Bound v a)
  r: Clean a and not (Bound v a) by or_e sh s_at s_bot s_bin s_q
  therefore forall v a x. FS0 -> CLEAN -> BOUND -> CleanLeast CleanInv -> Clean x -> QNode v a x -> Clean a and not (Bound v a)

theorem clean_bin:
  variable a b x
  assume fs0:   FS0
  assume clean: CLEAN
  assume least: CleanLeast CleanInv
  assume cx:    Clean x
  assume bn:    BinNode a b x
  qcl: Qcl                                by and_e clean
  inv: forall x1. Clean x1 -> CleanInv x1 by imp_e clean_inv fs0 clean least
  ix:  CleanInv x                         by imp_e inv cx
  sh:  CleanShape x                       by and_e ix
  lemma s_at:
    assume h: exists p l. Node2 T1 p l x
    lemma wit:
      variable p l
      assume nd: Node2 T1 p l x
      f: absurd              by imp_e at_bin_apart fs0 nd bn
      r: Clean a and Clean b by absurd_e f
      therefore forall p l. Node2 T1 p l x -> Clean a and Clean b
    r: Clean a and Clean b by exists_e h wit
    therefore (exists p l. Node2 T1 p l x) -> Clean a and Clean b
  lemma s_bot:
    assume h: exists n. Nil n and Node1 T0 n x
    lemma wit:
      variable n
      assume hn: Nil n and Node1 T0 n x
      nn: Nil n        by and_e hn
      nd: Node1 T0 n x by and_e hn
      lemma c2:
        assume m: Node2 T2 a b x
        f: absurd by imp_e node1_node2_apart T0 T2 fs0 nn nd m
        therefore Node2 T2 a b x -> absurd
      lemma c3:
        assume m: Node2 T3 a b x
        f: absurd by imp_e node1_node2_apart T0 T3 fs0 nn nd m
        therefore Node2 T3 a b x -> absurd
      lemma c4:
        assume m: Node2 T4 a b x
        f: absurd by imp_e node1_node2_apart T0 T4 fs0 nn nd m
        therefore Node2 T4 a b x -> absurd
      f: absurd              by or_e bn c2 c3 c4
      r: Clean a and Clean b by absurd_e f
      therefore forall n. (Nil n and Node1 T0 n x) -> Clean a and Clean b
    r: Clean a and Clean b by exists_e h wit
    therefore (exists n. Nil n and Node1 T0 n x) -> Clean a and Clean b
  lemma s_bin:
    assume h: exists a1 b1. Clean a1 and Clean b1 and BinNode a1 b1 x
    lemma wit:
      variable a1 b1
      assume hb: Clean a1 and Clean b1 and BinNode a1 b1 x
      ca1: Clean a1            by and_e hb
      cb1: Clean b1            by and_e hb
      bn1: BinNode a1 b1 x     by and_e hb
      e:   Eq a1 a and Eq b1 b by imp_e binnode_parts fs0 bn1 bn
      ea:  Eq a1 a             by and_e e
      eb:  Eq b1 b             by and_e e
      ca:  Clean a             by imp_e qcl ea ca1
      cb:  Clean b             by imp_e qcl eb cb1
      r:   Clean a and Clean b by and_i ca cb
      therefore forall a1 b1. (Clean a1 and Clean b1 and BinNode a1 b1 x) -> Clean a and Clean b
    r: Clean a and Clean b by exists_e h wit
    therefore (exists a1 b1. Clean a1 and Clean b1 and BinNode a1 b1 x) -> Clean a and Clean b
  lemma s_q:
    assume h: exists v1 a1. Clean a1 and not (Bound v1 a1) and QNode v1 a1 x
    lemma wit:
      variable v1 a1
      assume hq: Clean a1 and not (Bound v1 a1) and QNode v1 a1 x
      q1: QNode v1 a1 x       by and_e hq
      f:  absurd              by imp_e bin_q_apart fs0 bn q1
      r:  Clean a and Clean b by absurd_e f
      therefore forall v1 a1. (Clean a1 and not (Bound v1 a1) and QNode v1 a1 x) -> Clean a and Clean b
    r: Clean a and Clean b by exists_e h wit
    therefore (exists v1 a1. Clean a1 and not (Bound v1 a1) and QNode v1 a1 x) -> Clean a and Clean b
  r: Clean a and Clean b by or_e sh s_at s_bot s_bin s_q
  therefore forall a b x. FS0 -> CLEAN -> CleanLeast CleanInv -> Clean x -> BinNode a b x -> Clean a and Clean b
