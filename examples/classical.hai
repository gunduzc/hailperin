{- Classical logic is a theory: excluded middle, one instance at a time. -}

theory Classical
  em A: A or not A

{- Peirce's law, from excluded middle for A. -}
theorem peirce in Classical
  assume f: (A -> B) -> A
  lemma yes
    assume a: A
    yes: A -> A                           by imp_i a a
  lemma no
    assume na: not A
    lemma ab
      assume a: A
      x: absurd                           by imp_e na a
      b: B                                by absurd_e x
      ab: A -> B                          by imp_i a b
    a: A                                  by imp_e f ab
    no: not A -> A                        by imp_i na a
  a: A                                    by or_e (Classical.em A) yes no
  peirce: ((A -> B) -> A) -> A            by imp_i f a

{- Double negation elimination. -}
theorem dne in Classical
  assume nna: not (not A)
  lemma yes
    assume a: A
    yes: A -> A                           by imp_i a a
  lemma no
    assume na: not A
    f: absurd                             by imp_e nna na
    a: A                                  by absurd_e f
    no: not A -> A                        by imp_i na a
  a: A                                    by or_e (Classical.em A) yes no
  dne: not (not A) -> A                   by imp_i nna a

{- Contraposition, the classical direction. -}
theorem contrapositive in Classical
  assume h: not B -> not A
  assume a: A
  lemma yes
    assume b: B
    yes: B -> B                           by imp_i b b
  lemma no
    assume nb: not B
    na: not A                             by imp_e h nb
    f:  absurd                            by imp_e na a
    b:  B                                 by absurd_e f
    no: not B -> B                        by imp_i nb b
  b: B                                    by or_e (Classical.em B) yes no
  contrapositive: (not B -> not A) -> A -> B
                                          by imp_i h a b
