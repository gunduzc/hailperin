-- Classical logic is a schema: excluded middle, assumed one instance at a time.

define ExcludedMiddle A = A or not A

-- Peirce's law, from excluded middle for A.
theorem peirce:
  predicate A
  predicate B
  assume em: ExcludedMiddle A
  assume f: (A -> B) -> A
  lemma yes:
    assume a: A
    therefore A -> A
  lemma no:
    assume na: not A
    lemma ab:
      assume a: A
      x: absurd by imp_e na a
      b: B      by absurd_e x
      therefore A -> B
    a: A by imp_e f ab
    therefore not A -> A
  a: A by or_e em yes no
  therefore ExcludedMiddle A -> ((A -> B) -> A) -> A

-- Double negation elimination.
theorem dne:
  predicate A
  assume em: ExcludedMiddle A
  assume nna: not (not A)
  lemma yes:
    assume a: A
    therefore A -> A
  lemma no:
    assume na: not A
    f: absurd by imp_e nna na
    a: A      by absurd_e f
    therefore not A -> A
  a: A by or_e em yes no
  therefore ExcludedMiddle A -> not (not A) -> A

-- Contraposition, the classical direction.
theorem contrapositive:
  predicate A
  predicate B
  assume em: ExcludedMiddle B
  assume h: not B -> not A
  assume a: A
  lemma yes:
    assume b: B
    therefore B -> B
  lemma no:
    assume nb: not B
    na: not A by imp_e h nb
    f: absurd by imp_e na a
    b: B      by absurd_e f
    therefore not B -> B
  b: B by or_e em yes no
  therefore ExcludedMiddle B -> (not B -> not A) -> A -> B
