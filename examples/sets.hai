{- Set theory with membership as the only primitive and equality defined extensionally: the
   definitions, the constructive core `Sets`, and `ZFC` on top of it. -}

define Iff A B = (A -> B) and (B -> A)
define Eq x y = forall z. Iff (In z x) (In z y)
define Sub x y = forall z. In z x -> In z y
define Empty x = forall z. not (In z x)
define Successor x s = forall z. Iff (In z s) (In z x or Eq z x)
{- Ordered pairs and functions, up to equality. -}
define Single s a = forall w. Iff (In w s) (Eq w a)                        {- s = {a} -}
define Doub d a b = forall w. Iff (In w d) (Eq w a or Eq w b)              {- d = {a, b} -}
define OPair p a b = forall z. Iff (In z p) (Single z a or Doub z a b)     {- p = (a, b) -}
define Maps f a b = exists p. OPair p a b and In p f                       {- f contains (a, b) -}

{- The constructive core, then ZFC. -}
theory Sets
  ext:    forall x y. Eq x y -> forall z. In x z -> In y z
  empty:  exists x. Empty x
  pair:   forall a b. exists p. forall z. Iff (In z p) (Eq z a or Eq z b)
  union:  forall a. exists u. forall z. Iff (In z u) (exists y. In y a and In z y)
  power:  forall a. exists p. forall z. Iff (In z p) (Sub z a)
  inf:    exists i. (exists e. Empty e and In e i)
                and (forall x. In x i -> exists s. Successor x s and In s i)
  sep P:  forall a. exists s. forall z. Iff (In z s) (In z a and P z)
  repl R: forall a. (forall x. In x a -> exists y. R x y and forall y1. R x y1 -> Eq y y1)
                 -> exists b. forall y. Iff (In y b) (exists x. In x a and R x y)

theory ZFC
  include Sets
  found:  forall a. (exists x. In x a) -> exists y. In y a and not (exists z. In z y and In z a)
  choice: forall s. (forall x. In x s -> exists y. In y x)
            -> exists f. forall x. In x s
                 -> exists y. In y x and Maps f x y and forall y1. Maps f x y1 -> Eq y y1

{- Foundation as membership induction, as a theory of its own. -}
theory ZFEps
  include Sets
  eps P: (forall x. (forall y. In y x -> P y) -> P x) -> forall x. P x

define NotSelf x = not (In x x)
