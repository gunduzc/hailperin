-- Quine's New Foundations, finitely axiomatized after Hailperin (1944), in the form used by
-- the Metamath and Lean developments of NF.

predicate In x y
define Iff A B = (A -> B) and (B -> A)
define Eq x y = forall z. Iff (In z x) (In z y)
define Sub x y = forall z. In z x -> In z y
define Single s a = forall w. Iff (In w s) (Eq w a)                         -- s = {a}
define Doub d a b = forall w. Iff (In w d) (Eq w a or Eq w b)               -- d = {a, b}
define OPair p a b = forall z. Iff (In z p) (Single z a or Doub z a b)      -- p = (a, b)
define PairIn a b x = exists p. OPair p a b and In p x                      -- (a, b) in x
define SinglesIn a b x = exists s t. Single s a and Single t b and PairIn s t x
define Triple q a b c = exists s ss p. Single s a and Single ss s and OPair p b c and OPair q ss p
define TripleIn a b c x = exists q. Triple q a b c and In q x
define Anti c x y = forall w. Iff (In w c) (not (In w x and In w y))        -- c = x | y
define Singletons u = forall y. Iff (In y u) (exists z. Single y z)         -- u = {{z}}

define Ext          = forall x y. Eq x y -> forall z. In x z -> In y z
define AntiExists   = forall x y. exists z. Anti z x y
define SingleExists = forall x. exists y. Single y x
define One          = exists x. Singletons x
define Cross        = forall x. exists y. forall z. Iff (In z y) (exists w t. OPair z w t and In t x)
define Conv         = forall x. exists y. forall z w. Iff (PairIn z w y) (PairIn w z x)
define Simage       = forall x. exists y. forall z w. Iff (SinglesIn z w y) (PairIn z w x)
define Ins2         = forall x. exists y. forall z w t. Iff (TripleIn z w t y) (PairIn z t x)
define Ins3         = forall x. exists y. forall z w t. Iff (TripleIn z w t y) (PairIn z w x)
define Lower        = forall x. exists y. forall z. Iff (In z y) (forall w. exists s. Single s z and PairIn w s x)
define Incl         = exists x. forall y z. Iff (PairIn y z x) (Sub y z)

define NF = Ext and AntiExists and SingleExists and One and Cross and Conv and Simage and Ins2 and Ins3 and Lower and Incl

-- There is a universal set: 1 | (1 | 1). Constructive.
theorem universe:
  assume nf: NF
  anti: AntiExists                        by and_e nf
  one:  One                               by and_e nf
  lemma c1:
    variable u
    assume hu: Singletons u
    au: exists c. Anti c u u
                                          by forall_e anti u u
    lemma c2:
      variable c
      assume hc: Anti c u u
      av: exists v. Anti v u c
                                          by forall_e anti u c
      lemma c3:
        variable v
        assume hv: Anti v u c
        lemma every:
          variable w
          hvw: Iff (In w v) (not (In w u and In w c))
                                          by forall_e hv w
          bwd: not (In w u and In w c) -> In w v
                                          by and_e hvw
          lemma nk:
            assume k: In w u and In w c
            wu:   In w u                  by and_e k
            wc:   In w c                  by and_e k
            hcw:  Iff (In w c) (not (In w u and In w u))
                                          by forall_e hc w
            fwd:  In w c -> not (In w u and In w u)
                                          by and_e hcw
            n:    not (In w u and In w u) by imp_e fwd wc
            both: In w u and In w u       by and_i wu wu
            f:    absurd                  by imp_e n both
            therefore not (In w u and In w c)
          wv: In w v                      by imp_e bwd nk
          therefore forall w. In w v
        ex: exists v1. forall w. In w v1  by exists_i every
        therefore forall v. Anti v u c -> exists v1. forall w. In w v1
      r1: exists v1. forall w. In w v1    by exists_e av c3
      therefore forall c. Anti c u u -> exists v1. forall w. In w v1
    r2: exists v1. forall w. In w v1      by exists_e au c2
    therefore forall u. Singletons u -> exists v1. forall w. In w v1
  k: exists v. forall w. In w v           by exists_e one c1
  therefore NF -> exists v. forall w. In w v

-- So some set is an element of itself, unlike in ZFC.
theorem self_member:
  assume nf: NF
  lemma c:
    variable v
    assume hv: forall w. In w v
    vv: In v v                            by forall_e hv v
    ex: exists u. In u u                  by exists_i vv
    therefore forall v. (forall w. In w v) -> exists u. In u u
  univ: exists v. forall w. In w v        by imp_e universe nf
  k: exists u. In u u                     by exists_e univ c
  therefore NF -> exists u. In u u
