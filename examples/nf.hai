{- Quine's New Foundations, finitely axiomatized after Hailperin (1944), in the form used by
   the Metamath and Lean developments of NF. -}

define Iff A B = (A -> B) and (B -> A)
define Eq x y = forall z. Iff (In z x) (In z y)
define Sub x y = forall z. In z x -> In z y
define Single s a = forall w. Iff (In w s) (Eq w a)                         {- s = {a} -}
define Doub d a b = forall w. Iff (In w d) (Eq w a or Eq w b)               {- d = {a, b} -}
define OPair p a b = forall z. Iff (In z p) (Single z a or Doub z a b)      {- p = (a, b) -}
define PairIn a b x = exists p. OPair p a b and In p x                      {- (a, b) in x -}
define SinglesIn a b x = exists s t. Single s a and Single t b and PairIn s t x
define Triple q a b c = exists s ss p. Single s a and Single ss s and OPair p b c and OPair q ss p
define TripleIn a b c x = exists q. Triple q a b c and In q x

theory NF
  ext:    forall x y. Eq x y -> forall z. In x z -> In y z
  anti:   forall x y. exists z. forall w. Iff (In w z) (not (In w x and In w y))
  single: forall x. exists y. Single y x
  one:    exists x. forall y. Iff (In y x) (exists z. Single y z)
  cross:  forall x. exists y. forall z. Iff (In z y) (exists w t. OPair z w t and In t x)
  conv:   forall x. exists y. forall z w. Iff (PairIn z w y) (PairIn w z x)
  simage: forall x. exists y. forall z w. Iff (SinglesIn z w y) (PairIn z w x)
  ins2:   forall x. exists y. forall z w t. Iff (TripleIn z w t y) (PairIn z t x)
  ins3:   forall x. exists y. forall z w t. Iff (TripleIn z w t y) (PairIn z w x)
  lower:  forall x. exists y. forall z. Iff (In z y) (forall w. exists s. Single s z and PairIn w s x)
  incl:   exists x. forall y z. Iff (PairIn y z x) (Sub y z)

{- There is a universal set: 1 | (1 | 1). Constructive. -}
theorem universe in NF
  assume hu: forall y. Iff (In y u) (exists z. Single y z)
  assume hc: forall w. Iff (In w c) (not (In w u and In w u))
  assume hv: forall w. Iff (In w v) (not (In w u and In w c))
  au: exists c. forall w. Iff (In w c) (not (In w u and In w u))    by forall_e NF.anti u u
  av: exists v. forall w. Iff (In w v) (not (In w u and In w c))    by forall_e NF.anti u c
  lemma every
    hvw: Iff (In w v) (not (In w u and In w c))                     by forall_e hv w
    bwd: not (In w u and In w c) -> In w v                          by and_e2 hvw
    lemma nk
      assume k: In w u and In w c
      wu:   In w u                                                  by and_e1 k
      wc:   In w c                                                  by and_e2 k
      hcw:  Iff (In w c) (not (In w u and In w u))                  by forall_e hc w
      fwd:  In w c -> not (In w u and In w u)                       by and_e1 hcw
      n:    not (In w u and In w u)                                 by imp_e fwd wc
      both: In w u and In w u                                       by and_i wu wu
      f:    absurd                                                  by imp_e n both
      nk:   not (In w u and In w c)                                 by imp_i k f
    wv: In w v                                                      by imp_e bwd nk
    every: forall w. In w v                                         by forall_i w wv
  ex: exists v1. forall w. In w v1                                  by exists_i every
  r1: exists v1. forall w. In w v1                                  by exists_e av hv ex
  r2: exists v1. forall w. In w v1                                  by exists_e au hc r1
  universe: exists v. forall w. In w v                              by exists_e NF.one hu r2

{- So some set is an element of itself, unlike in ZFC. -}
theorem self_member in NF
  assume hv: forall w. In w v
  vv: In v v                                                        by forall_e hv v
  ex: exists u. In u u                                              by exists_i vv
  self_member: exists u. In u u                                     by exists_e universe hv ex
