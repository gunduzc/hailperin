{- Peano arithmetic: Q, induction, and classical logic. HA is the same without the logic. -}

import q
import classical

theory HA
  include Q
  ind P: (forall x. Zero x -> P x) -> (forall y x. P x -> Succ x y -> P y) -> forall x. P x

theory PA
  include HA
  include Classical

{- Everything is zero or a successor, by induction. -}
define ZeroOrSucc x = Zero x or exists p. Succ p x

theorem zero_or_succ in HA
  lemma base
    assume zx: Zero x
    k: ZeroOrSucc x                       by or_i1 zx
    b: Zero x -> ZeroOrSucc x             by imp_i zx k
    base: forall x. Zero x -> ZeroOrSucc x
                                          by forall_i x b
  lemma step
    assume ih: ZeroOrSucc x
    assume sxy: Succ x y
    e: exists p. Succ p y                 by exists_i sxy
    k: ZeroOrSucc y                       by or_i2 e
    s: ZeroOrSucc x -> Succ x y -> ZeroOrSucc y
                                          by imp_i ih sxy k
    step: forall y x. ZeroOrSucc x -> Succ x y -> ZeroOrSucc y
                                          by forall_i y x s
  zero_or_succ: forall x. ZeroOrSucc x    by imp_e (HA.ind ZeroOrSucc) base step
