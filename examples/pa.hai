-- Peano arithmetic: Q, induction, and classical logic. A theorem of HA assumes Q and the
-- instances of induction it uses, and a theorem of PA instances of excluded middle as well.

import q
import classical

define Induction (P x) = (forall x. Zero x -> P x) -> (forall y x. P x -> Succ x y -> P y) -> forall x. P x

-- Everything is zero or a successor, by induction.
define ZeroOrSucc x = Zero x or exists p. Succ p x

theorem zero_or_succ:
  assume ind: Induction ZeroOrSucc
  lemma base:
    variable x
    assume zx: Zero x
    k: ZeroOrSucc x by or_i zx
    therefore forall x. Zero x -> ZeroOrSucc x
  lemma step:
    variable y x
    assume ih: ZeroOrSucc x
    assume sxy: Succ x y
    e: exists p. Succ p y by exists_i sxy
    k: ZeroOrSucc y       by or_i e
    therefore forall y x. ZeroOrSucc x -> Succ x y -> ZeroOrSucc y
  r: forall x. ZeroOrSucc x by imp_e ind base step
  therefore Induction ZeroOrSucc -> forall x. ZeroOrSucc x
