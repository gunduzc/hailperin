{- Tarski: no predicate satisfies the truth schema at its own liar. The diagonal lemma is a
   hypothesis here: `L` is a sentence equivalent to "no code of L is true". -}

define Iff A B = (A -> B) and (B -> A)
define Holds True Code = exists c. Code c and True c     {- some code of L is true -}

theorem tarski
  assume liar: Iff L (not (Holds True Code))
  assume t:    Iff (Holds True Code) L
  lemma no
    assume h: Holds True Code
    t1: Holds True Code -> L                    by and_e1 t
    l:  L                                       by imp_e t1 h
    l1: L -> not (Holds True Code)              by and_e1 liar
    nh: not (Holds True Code)                   by imp_e l1 l
    f:  absurd                                  by imp_e nh h
    no: not (Holds True Code)                   by imp_i h f
  l2: not (Holds True Code) -> L                by and_e2 liar
  l:  L                                         by imp_e l2 no
  t2: L -> Holds True Code                      by and_e2 t
  h:  Holds True Code                           by imp_e t2 l
  f:  absurd                                    by imp_e no h
  tarski: Iff L (not (Holds True Code)) -> Iff (Holds True Code) L -> absurd
                                                by imp_i liar t f
