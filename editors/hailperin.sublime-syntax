%YAML 1.2
---
# Hailperin proof files. Works with Sublime Text and bat.
name: Hailperin
file_extensions: [hai]
scope: source.hailperin

contexts:
  main:
    - include: comment
    - match: '\b(theorem|lemma|define|import|predicate|variable|assume|therefore|by)\b'
      scope: keyword.control.hailperin
    - match: '\b(forall|exists|and|or|not|absurd)\b'
      scope: keyword.operator.logical.hailperin
    - match: '\b(imp_e|and_i|and_e|or_i|or_e|absurd_e|forall_e|exists_i|exists_e|reit|auto)\b'
      scope: string.other.rule.hailperin
    - match: '->'
      scope: keyword.operator.hailperin
    - match: '\b[A-Z][A-Za-z0-9_]*\b'
      scope: entity.name.function.hailperin
    - match: '\b[a-z][A-Za-z0-9_]*(?=\s*:)'
      scope: variable.parameter.hailperin
    - match: '[().=]'
      scope: punctuation.hailperin

  comment:
    - match: '--'
      scope: punctuation.definition.comment.hailperin
      push:
        - meta_scope: comment.line.hailperin
        - match: '$'
          pop: true
